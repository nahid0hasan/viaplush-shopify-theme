  #viaplush-featured-collection-{{ sid }} .viaplush-featured-collection__btn-spinner {
    display: none;
    width: 14px;
    height: 14px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: viaplush-vfc-spin-{{ sid }} 0.65s linear infinite;
    flex-shrink: 0;
  }
  #viaplush-featured-collection-{{ sid }} .viaplush-featured-collection__atc.is-loading .viaplush-featured-collection__btn-spinner,
  #viaplush-featured-collection-{{ sid }} .viaplush-featured-collection__buynow.is-loading .viaplush-featured-collection__btn-spinner {
    display: block;
  }
  #viaplush-featured-collection-{{ sid }} .viaplush-featured-collection__atc.is-loading,
  #viaplush-featured-collection-{{ sid }} .viaplush-featured-collection__buynow.is-loading {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  #viaplush-featured-collection-{{ sid }} .viaplush-featured-collection__atc.is-loading .viaplush-featured-collection__btn-label,
  #viaplush-featured-collection-{{ sid }} .viaplush-featured-collection__buynow.is-loading .viaplush-featured-collection__btn-label {
    opacity: 0.85;
  }
  #viaplush-featured-collection-{{ sid }} .viaplush-featured-collection__atc.is-success,
  #viaplush-featured-collection-{{ sid }} .viaplush-featured-collection__buynow.is-success {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  #viaplush-featured-collection-{{ sid }} .viaplush-featured-collection__atc.is-success .viaplush-featured-collection__btn-label,
  #viaplush-featured-collection-{{ sid }} .viaplush-featured-collection__buynow.is-success .viaplush-featured-collection__btn-label {
    opacity: 1;
  }
  #viaplush-featured-collection-{{ sid }} .viaplush-featured-collection__atc.is-success .viaplush-featured-collection__btn-spinner,
  #viaplush-featured-collection-{{ sid }} .viaplush-featured-collection__buynow.is-success .viaplush-featured-collection__btn-spinner,
  #viaplush-featured-collection-{{ sid }} .viaplush-featured-collection__atc.is-error .viaplush-featured-collection__btn-spinner {
