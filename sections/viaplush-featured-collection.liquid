</style>
<script>
  (function () {
    var root = document.getElementById('viaplush-featured-collection-{{ sid }}');
    if (!root) return;

    var moneyFormat = {{ shop.money_format | json }};
    var atcText = {{ s.atc_button_text | default: 'ADD TO CART' | json }};
    var atcSuccessText = {{ s.atc_success_text | default: 'SUCCESSFULLY ADDED' | json }};
    var atcErrorText = {{ s.atc_error_text | default: 'TRY AGAIN' | json }};
    var atcSuccessDuration = {{ s.atc_success_duration | default: 3000 | json }};
    var atcErrorDuration = {{ s.atc_error_duration | default: 2500 | json }};
    var checkoutEmptyText = {{ s.checkout_empty_message | default: 'Your cart is empty. Add a tee first.' | json }};
    var msgAdded = {{ s.tier_msg_added | default: 'Successfully added to cart!' | json }};
    var tierMessages = [
      {{ s.tier_msg_1 | default: 'Add 1 more tee to unlock 2 FOR $75 + FREE SHIPPING!' | json }},
      {{ s.tier_msg_2 | default: "You've unlocked 2 FOR $75 + FREE SHIPPING! Add 1 more tee to unlock 3 FOR $105 + FREE SHIPPING + FREE GIFT!" | json }},
      {{ s.tier_msg_3 | default: "You've unlocked 3 FOR $105 + FREE SHIPPING + FREE GIFT! Add 2 more tees to unlock 5 FOR $145 + FREE SHIPPING + BONUS GIFTS!" | json }},
      {{ s.tier_msg_4 | default: 'Just 1 more tee to unlock 5 FOR $145 + FREE SHIPPING + BONUS GIFTS!' | json }},
      {{ s.tier_msg_5 | default: "Congratulations! You've unlocked 5 FOR $145 + FREE SHIPPING + BONUS GIFTS!" | json }}
    ];
    var msgCartLink = {{ s.tier_msg_link | json }};
    var soldOutText = {{ s.sold_out_text | default: 'SOLD OUT' | json }};
    var sizeErrorMsg = {{ s.size_error_message | default: 'Please select a size' | json }};
    var enableHoverSwap = {{ s.enable_hover_swap | default: true | json }};
    var shopRoot = (window.Shopify && Shopify.routes && Shopify.routes.root) ? Shopify.routes.root : '/';
    var cartAddUrl = shopRoot + 'cart/add.js';
    var cartUrl = {{ routes.cart_url | json }};
    var stickyBar = root.querySelector('[data-sticky-bar]');

    function fetchCart() {
      return fetch(shopRoot + 'cart.js', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); });
    }

    // Only products from this section's collection count toward the Archive Sale bundles.
    var dealProductIds = {{ collection.products | map: 'id' | json }};

    function dealItemCount(cart) {
      if (!cart || !cart.items) return 0;
      if (!dealProductIds || !dealProductIds.length) return cart.item_count;
      return cart.items.reduce(function (n, item) {
        return n + (dealProductIds.indexOf(item.product_id) !== -1 ? item.quantity : 0);
      }, 0);
    }

    function fillCartMessage(msgEl, cart) {
      if (!msgEl) return;
      var count = dealItemCount(cart);
      msgEl.textContent = '';
      msgEl.hidden = !count;
      if (msgEl.hidden) return;

      var tierText = tierMessages[Math.min(count, tierMessages.length) - 1] || '';

      var check = document.createElement('span');
      check.className = 'viaplush-featured-collection__cart-msg-check';
      check.setAttribute('aria-hidden', 'true');
      check.textContent = '\u2713';
      msgEl.appendChild(check);

      var body = document.createElement('span');
      body.className = 'viaplush-featured-collection__cart-msg-body';

      var added = document.createElement('strong');
      added.className = 'viaplush-featured-collection__cart-msg-added';
      added.textContent = msgAdded;
      body.appendChild(added);

      if (tierText) {
        body.appendChild(document.createTextNode(' ' + tierText));
      }

      if (msgCartLink) {
        body.appendChild(document.createTextNode(' '));
        var link = document.createElement('a');
        link.href = cartUrl;
        link.textContent = msgCartLink;
        body.appendChild(link);
      }

      msgEl.appendChild(body);
    }

    // The message belongs to the card the shopper last added from; it is refreshed
    // (or hidden) whenever the cart changes, so the milestone always matches the cart.
    var activeMsgEl = null;

    function showCartMessage(card, cart) {
      root.querySelectorAll('[data-cart-msg]').forEach(function (el) {
        el.hidden = true;
        el.textContent = '';
      });
      activeMsgEl = card.querySelector('[data-cart-msg]');
      fillCartMessage(activeMsgEl, cart);
      updateStickyBar(cart, true);
    }

    function refreshActiveMessage(cart) {
      if (!cart) return;
      if (activeMsgEl) fillCartMessage(activeMsgEl, cart);
      if (stickyBar) {
        var stickyMsg = stickyBar.querySelector('[data-sticky-msg]');
        if (stickyMsg && !stickyMsg.hidden) fillCartMessage(stickyMsg, cart);
        updateStickyBar(cart, false);
      }
    }

    function refreshFromServer() {
      if (!activeMsgEl && !stickyBar) return;
      fetchCart().then(refreshActiveMessage).catch(function () {});
    }

    // Catch quantity changes and removals made anywhere on the page (cart drawer, other sections).
    document.documentElement.addEventListener('viaplush:cart:updated', function (e) {
      if (e.detail && e.detail.source === 'viaplush-featured-collection') return;
      if (e.detail && e.detail.cart && e.detail.cart.items) {
        refreshActiveMessage(e.detail.cart);
      } else {
        refreshFromServer();
      }
    });
    ['cart:updated', 'cart:refresh', 'cart-drawer:updated', 'cart:change'].forEach(function (name) {
      document.addEventListener(name, refreshFromServer);
    });

    if (window.fetch && !window.__viaplushCartFetchWatch) {
      window.__viaplushCartFetchWatch = true;
      var nativeFetch = window.fetch;
      window.fetch = function (input, init) {
        var url = typeof input === 'string' ? input : (input && input.url) || '';
        var p = nativeFetch.apply(this, arguments);
        if (/\/cart\/(change|update|clear)(\.js)?/.test(url)) {
          p.then(function () {
            document.documentElement.dispatchEvent(new CustomEvent('viaplush:cart:external-change'));
          }).catch(function () {});
        }
        return p;
      };
    }
    document.documentElement.addEventListener('viaplush:cart:external-change', refreshFromServer);

    window.addEventListener('pageshow', function (e) {
      if (e.persisted) refreshFromServer();
    });
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible') refreshFromServer();
    });

    function updateStickyBar(cart, showMsg) {
      if (!stickyBar || !cart) return;
      var countEl = stickyBar.querySelector('[data-sticky-count]');
      if (countEl) countEl.textContent = cart.item_count > 0 ? ' (' + cart.item_count + ')' : '';
      if (showMsg) fillCartMessage(stickyBar.querySelector('[data-sticky-msg]'), cart);
    }

    // CHECKOUT: goes to checkout with whatever is already in the cart — no size check, nothing added.
    function goToCheckout(btn, msgEl) {
      if (btn.classList.contains('is-loading')) return;
      setButtonLoading(btn, true);
      fetchCart()
        .then(function (cart) {
          if (cart && cart.item_count > 0) {
            window.location.href = shopRoot + 'checkout';
            return;
          }
          setButtonLoading(btn, false);
          btn.disabled = false;
          if (msgEl) { msgEl.textContent = checkoutEmptyText; msgEl.hidden = false; }
        })
        .catch(function () {
          window.location.href = shopRoot + 'checkout';
        });
    }

    // VIEW CART: only opens the cart — no size check, nothing added.
    function openCart(e) {
      if (window.ViaplushCartDrawer && typeof window.ViaplushCartDrawer.open === 'function') {
        e.preventDefault();
        window.ViaplushCartDrawer.open();
      }
    }

    function updateHeaderCartCount(cart) {
      if (!cart || typeof cart.item_count !== 'number') return;
      if (window.ViaplushCartDrawer && typeof window.ViaplushCartDrawer.updateCount === 'function') {
        window.ViaplushCartDrawer.updateCount(cart);
        if (typeof window.ViaplushCartDrawer.pulseCount === 'function') {
          window.ViaplushCartDrawer.pulseCount();
        }
        return;
      }
      document.documentElement.dispatchEvent(new CustomEvent('viaplush:cart:updated', {
        bubbles: true,
        detail: { cart: cart, source: 'viaplush-featured-collection' }
      }));
      pulseCartCountFallback();
    }

    function pulseCartCountFallback() {
      var countEl = document.querySelector('[data-viaplush-cart-count]');
      if (!countEl) return;
      countEl.classList.remove('viaplush-minimal-header__cart-count--pulse');
      void countEl.offsetWidth;
      countEl.classList.add('viaplush-minimal-header__cart-count--pulse');
    }

    var COLOR_NAME_MAP = {
      'black': '#000000', 'white': '#ffffff', 'red': '#c41e3a', 'pink': '#e8a0b8',
      'hot pink': '#ff69b4', 'rose': '#e8a0b8', 'blush': '#f5c6cb', 'sage': '#9caf88',
      'sage green': '#9caf88', 'green': '#2d6a4f', 'olive': '#6b7c3e', 'blue': '#1e4d8c',
      'navy': '#001f3f', 'grey': '#808080', 'gray': '#808080', 'charcoal': '#36454f',
      'beige': '#d4c4a8', 'cream': '#f5f0e8', 'tan': '#c9a87c', 'brown': '#6b4226',
      'orange': '#e07020', 'yellow': '#e8c840', 'purple': '#6b3fa0', 'burgundy': '#6b1c2a',
      'wine': '#722f37', 'lavender': '#b8a9d4', 'mint': '#98d4bb', 'coral': '#e8705a',
      'teal': '#008080', 'khaki': '#c3b091', 'ivory': '#fffff0', 'sand': '#c2b280',
      'stone': '#928e85', 'natural': '#e8dcc8', 'nude': '#e3bc9a', 'camel': '#c19a6b'
    };

    function formatMoney(cents) {
      if (typeof cents !== 'number') return '';
      if (window.Shopify && typeof Shopify.formatMoney === 'function') {
        return Shopify.formatMoney(cents, moneyFormat);
      }
      return '$' + (cents / 100).toFixed(2);
    }

    function colorFromName(name) {
      if (!name) return '#cccccc';
      var key = String(name).toLowerCase().trim();
      if (COLOR_NAME_MAP[key]) return COLOR_NAME_MAP[key];
      var parts = key.split(/[\s\/\-]+/);
      for (var i = 0; i < parts.length; i++) {
        if (COLOR_NAME_MAP[parts[i]]) return COLOR_NAME_MAP[parts[i]];
      }
      for (var mapKey in COLOR_NAME_MAP) {
        if (key.indexOf(mapKey) !== -1) return COLOR_NAME_MAP[mapKey];
      }
      var hash = 0;
      for (var j = 0; j < key.length; j++) hash = key.charCodeAt(j) + ((hash << 5) - hash);
      var hue = Math.abs(hash) % 360;
      return 'hsl(' + hue + ', 35%, 55%)';
    }

    function applySwatchColors(scope) {
      (scope || root).querySelectorAll('[data-color-name]').forEach(function (el) {
        if (!el.style.backgroundColor || el.style.backgroundColor === '') {
          el.style.backgroundColor = colorFromName(el.getAttribute('data-color-name'));
        }
      });
    }

    function getOptionValue(variant, index) {
      if (index === 0) return variant.option1;
      if (index === 1) return variant.option2;
      if (index === 2) return variant.option3;
      return null;
    }

    function findVariant(data, colorVal, sizeVal) {
      if (data.sizeIndex !== null && sizeVal) {
        return data.variants.find(function (v) {
          var colorOk = data.colorIndex === null || getOptionValue(v, data.colorIndex) === colorVal;
          var sizeOk = getOptionValue(v, data.sizeIndex) === sizeVal;
          return colorOk && sizeOk;
        });
      }
      if (colorVal && data.colorIndex !== null) {
        return data.variants.find(function (v) {
          return getOptionValue(v, data.colorIndex) === colorVal && v.available;
        }) || data.variants.find(function (v) {
          return getOptionValue(v, data.colorIndex) === colorVal;
        });
      }
      return data.variants.find(function (v) { return v.available; }) || data.variants[0];
    }

    function getImagesForColor(data, colorVal) {
      var variants = data.variants.filter(function (v) {
        return data.colorIndex === null || getOptionValue(v, data.colorIndex) === colorVal;
      });
      var variantIds = variants.map(function (v) { return v.id; });
      var front = null;
      var back = null;
      variants.some(function (v) {
        if (v.featured_image) { front = v.featured_image; return true; }
        return false;
      });
      var colorImages = data.images.filter(function (img) {
        return img.variant_ids && img.variant_ids.some(function (id) { return variantIds.indexOf(id) !== -1; });
      });
      if (!colorImages.length) colorImages = data.images.slice();
      if (!front && colorImages.length) front = colorImages[0];
      if (!front && data.images.length) front = data.images[0];
      if (front) {
        back = colorImages.find(function (img) { return img.id !== front.id; });
      }
      if (!back && data.images.length > 1) {
        back = data.images.find(function (img) { return !front || img.id !== front.id; });
      }
      return { front: front, back: back };
    }

    function resolveImages(data, variant, colorVal) {
      if (variant && variant.featured_image) {
        var front = variant.featured_image;
        var back = null;
        var linked = data.images.filter(function (img) {
          return img.variant_ids && img.variant_ids.indexOf(variant.id) !== -1;
        });
        if (linked.length > 1) {
          back = linked.find(function (img) { return img.id !== front.id; });
        }
        if (!back && colorVal) {
          var colorImgs = getImagesForColor(data, colorVal);
          if (colorImgs.back && colorImgs.back.id !== front.id) back = colorImgs.back;
        }
        if (!back && data.images.length > 1) {
          back = data.images.find(function (img) { return img.id !== front.id; });
        }
        return { front: front, back: back };
      }
      if (colorVal) return getImagesForColor(data, colorVal);
      return { front: data.images[0] || null, back: data.images[1] || null };
    }

    function updateCardImages(card, data, variant, colorVal) {
      var imgs = resolveImages(data, variant, colorVal);
      var frontImg = card.querySelector('[data-front-image]');
      var backImg = card.querySelector('[data-back-image]');
      var media = card.querySelector('[data-media-link]');
      if (media) media.classList.remove('viaplush-featured-collection__media--show-back');
      if (frontImg && imgs.front) {
        frontImg.src = imgs.front.src;
        frontImg.srcset = imgs.front.src + ' 600w';
        frontImg.alt = imgs.front.alt || data.title;
      }
      if (backImg) {
        if (imgs.back) {
          backImg.src = imgs.back.src;
          backImg.alt = imgs.back.alt || data.title;
          backImg.hidden = false;
        } else {
          backImg.hidden = true;
        }
      }
    }

    function updateSizeAvailability(card, data, colorVal) {
      card.querySelectorAll('[data-size-fieldset] .viaplush-featured-collection__size-input').forEach(function (input) {
        var sizeVal = input.value;
        var match = data.variants.find(function (v) {
          var colorOk = data.colorIndex === null || getOptionValue(v, data.colorIndex) === colorVal;
          var sizeOk = data.sizeIndex === null || getOptionValue(v, data.sizeIndex) === sizeVal;
          return colorOk && sizeOk && v.available;
        });
        input.disabled = !match;
        var label = card.querySelector('label[for="' + input.id + '"]');
        if (label) label.classList.toggle('viaplush-featured-collection__size--disabled', !match);
        if (!match && input.checked) input.checked = false;
      });
    }

    function setButtonLoading(btn, loading) {
      if (!btn) return;
      btn.classList.toggle('is-loading', loading);
      btn.classList.remove('is-success');
      btn.setAttribute('aria-busy', loading ? 'true' : 'false');
      var spinner = btn.querySelector('.viaplush-featured-collection__btn-spinner');
      if (spinner) spinner.hidden = !loading;
      if (loading) btn.disabled = true;
    }

    function setButtonSuccess(btn, textEl, card, data, cart) {
      if (!btn) return;
      btn.classList.remove('is-loading', 'is-error');
      btn.classList.add('is-success');
      btn.setAttribute('aria-busy', 'false');
      btn.disabled = true;
      var spinner = btn.querySelector('.viaplush-featured-collection__btn-spinner');
      if (spinner) {
        spinner.hidden = true;
        spinner.style.display = 'none';
      }
      if (textEl) textEl.textContent = atcSuccessText;

      updateHeaderCartCount(cart);

      window.setTimeout(function () {
        btn.classList.remove('is-success');
        btn.disabled = false;
        if (textEl) textEl.textContent = atcText;
        updateCardUI(card, data);
      }, atcSuccessDuration);
    }

    function setButtonError(btn, textEl, card, data) {
      if (!btn) return;
      btn.classList.remove('is-loading', 'is-success');
      btn.classList.add('is-error');
      btn.setAttribute('aria-busy', 'false');
      btn.disabled = false;
      var spinner = btn.querySelector('.viaplush-featured-collection__btn-spinner');
      if (spinner) {
        spinner.hidden = true;
        spinner.style.display = 'none';
      }
      if (textEl) textEl.textContent = atcErrorText;
      window.setTimeout(function () {
        btn.classList.remove('is-error');
        if (textEl) textEl.textContent = atcText;
        updateCardUI(card, data);
      }, atcErrorDuration);
    }

    function updateCardUI(card, data) {
      var colorInput = card.querySelector('[data-color-fieldset] .viaplush-featured-collection__swatch-input:checked');
      var sizeInput = card.querySelector('[data-size-fieldset] .viaplush-featured-collection__size-input:checked');
      var colorVal = colorInput ? colorInput.value : null;
      var sizeVal = sizeInput ? sizeInput.value : null;

      if (data.colorIndex !== null && colorVal) updateSizeAvailability(card, data, colorVal);

      var variant = findVariant(data, colorVal, sizeVal);

      var atcBtn = card.querySelector('[data-add-to-cart]');
      var atcTextEl = card.querySelector('[data-atc-text]');
      var soldOut = !data.available;
      if (variant && sizeVal) {
        soldOut = !variant.available;
      } else if (colorVal && data.colorIndex !== null) {
        soldOut = !data.variants.some(function (v) {
          return getOptionValue(v, data.colorIndex) === colorVal && v.available;
        });
      }

      if (atcBtn && !atcBtn.classList.contains('is-loading') && !atcBtn.classList.contains('is-success') && !atcBtn.classList.contains('is-error')) {
        atcBtn.disabled = soldOut;
        atcBtn.dataset.variantId = variant ? variant.id : '';
      }
      if (atcTextEl && atcBtn && !atcBtn.classList.contains('is-loading') && !atcBtn.classList.contains('is-success') && !atcBtn.classList.contains('is-error')) atcTextEl.textContent = soldOut ? soldOutText : atcText;

      updateCardImages(card, data, variant, colorVal);
      card.dataset.selectedVariantId = variant ? variant.id : '';
      return { variant: variant, sizeVal: sizeVal, colorVal: colorVal };
    }

    function hideSizeError(card) {
      var err = card.querySelector('[data-size-error]');
      if (err) err.hidden = true;
    }

    function showSizeError(card) {
      var err = card.querySelector('[data-size-error]');
      if (err) { err.textContent = sizeErrorMsg; err.hidden = false; }
    }

    function addToCart(variantId) {
      return fetch(cartAddUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ items: [{ id: parseInt(variantId, 10), quantity: 1 }] })
      }).then(function (res) {
        return res.json().then(function (body) {
          if (!res.ok) throw body;
          return body;
        });
      }).then(fetchCart);
    }

    applySwatchColors(root);

    root.querySelectorAll('[data-product-card]').forEach(function (card) {
      var dataScript = card.querySelector('[data-product-data]');
      if (!dataScript) return;
      var data;
      try { data = JSON.parse(dataScript.textContent); } catch (e) { return; }

      applySwatchColors(card);

      var media = card.querySelector('[data-media-link]');
      if (media && enableHoverSwap) {
        media.addEventListener('click', function (e) {
          if (window.matchMedia('(hover: none)').matches) {
            e.preventDefault();
            media.classList.toggle('viaplush-featured-collection__media--show-back');
          }
        });
      }

      card.querySelectorAll('[data-color-fieldset] .viaplush-featured-collection__swatch-input').forEach(function (input) {
        input.addEventListener('change', function () {
          hideSizeError(card);
          updateCardUI(card, data);
        });
      });

      card.querySelectorAll('[data-size-fieldset] .viaplush-featured-collection__size-input').forEach(function (input) {
        input.addEventListener('change', function () {
          hideSizeError(card);
          updateCardUI(card, data);
        });
      });

      updateCardUI(card, data);

      var atcBtn = card.querySelector('[data-add-to-cart]');
      var atcTextEl = card.querySelector('[data-atc-text]');
      var viewCartBtn = card.querySelector('[data-view-cart]');
      var checkoutBtn = card.querySelector('[data-checkout]');

      if (atcBtn) {
        atcBtn.addEventListener('click', function () {
          if (atcBtn.classList.contains('is-success')) return;
          var state = updateCardUI(card, data);
          if (data.sizeIndex !== null && !state.sizeVal) { showSizeError(card); return; }
          if (!state.variant || !state.variant.available) return;

          atcBtn.disabled = true;
          atcBtn.setAttribute('aria-busy', 'true');

          addToCart(state.variant.id)
            .then(function (cart) {
              setButtonSuccess(atcBtn, atcTextEl, card, data, cart);
              showCartMessage(card, cart);
            })
            .catch(function () {
              setButtonError(atcBtn, atcTextEl, card, data);
            });
        });
      }

      if (viewCartBtn) {
        viewCartBtn.addEventListener('click', function (e) {
          hideSizeError(card);
          openCart(e);
        });
      }

      if (checkoutBtn) {
        checkoutBtn.addEventListener('click', function () {
          hideSizeError(card);
          goToCheckout(checkoutBtn, card.querySelector('[data-cart-msg]'));
        });
      }
    });

    // Sticky bar: visible only while the grid is on screen, so View cart / Checkout
    // are reachable from any row without scrolling to a card.
    if (stickyBar) {
      var stickyViewCart = stickyBar.querySelector('[data-view-cart]');
      var stickyCheckout = stickyBar.querySelector('[data-checkout]');
      if (stickyViewCart) stickyViewCart.addEventListener('click', openCart);
      if (stickyCheckout) {
        stickyCheckout.addEventListener('click', function () {
          goToCheckout(stickyCheckout, stickyBar.querySelector('[data-sticky-msg]'));
        });
      }

      var grid = root.querySelector('.viaplush-featured-collection__grid');
      var setStickyVisible = function (visible) {
        stickyBar.classList.toggle('is-visible', visible);
        stickyBar.setAttribute('aria-hidden', visible ? 'false' : 'true');
        stickyBar.querySelectorAll('a, button').forEach(function (el) {
          if (visible) el.removeAttribute('tabindex'); else el.setAttribute('tabindex', '-1');
        });
      };
      if (grid && 'IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          setStickyVisible(entries[0].isIntersecting);
        }, { threshold: 0 }).observe(grid);
      } else {
        setStickyVisible(true);
      }

      document.documentElement.addEventListener('viaplush:cart:updated', function (e) {
        if (e.detail && e.detail.cart) updateStickyBar(e.detail.cart, false);
      });
    }

    // Reset the Checkout spinner when the page is restored via the browser back button.
    window.addEventListener('pageshow', function (e) {
      if (!e.persisted) return;
      root.querySelectorAll('[data-checkout]').forEach(function (btn) {
        setButtonLoading(btn, false);
        btn.disabled = false;
      });
    });
  })();
</script>
