  #viaplush-featured-collection-{{ sid }} .viaplush-featured-collection__actions {
    display: flex;
    flex-direction: column;
    gap: var(--vfc-btn-gap);
  }
  #viaplush-featured-collection-{{ sid }} .viaplush-featured-collection__atc,
  #viaplush-featured-collection-{{ sid }} .viaplush-featured-collection__buynow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
