{%- comment -%}
  VIAPLUSH – Dynamic Featured Collection Grid
  Shopify OS 2.0 | Atelier-compatible | Scoped CSS + vanilla JS
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign s = section.settings
  assign container_type = s.container_type | default: 'theme'
  assign collection = s.collection
  assign color_option_name = s.color_option_name | default: 'Color'
  assign size_option_name = s.size_option_name | default: 'Size'

  if s.show_all_products
    assign product_limit = 50
  else
    assign product_limit = s.product_limit | default: 7
  endif

  assign aspect_css = 'auto'
  case s.image_aspect_ratio
    when 'square'
      assign aspect_css = '1 / 1'
    when '4_5'
      assign aspect_css = '4 / 5'
    when '3_4'
      assign aspect_css = '3 / 4'
  endcase

  assign view_all_url = collection.url | default: ''
  if s.view_all_url != blank
    assign view_all_url = s.view_all_url
  endif
-%}

<section
  id="viaplush-featured-collection-{{ sid }}"
  class="viaplush-featured-collection viaplush-featured-collection--container-{{ container_type }} viaplush-featured-collection--bg-{{ s.background_type | default: 'solid' }}{% if s.equal_card_height %} viaplush-featured-collection--equal-height{% endif %}"
  data-viaplush-featured-collection
  data-section-id="{{ sid }}"
  style="
    --vfc-bg: {{ s.background_color | default: '#F9F7F2' }};
    --vfc-grad-1: {{ s.gradient_color_1 | default: '#F9F7F2' }};
    --vfc-grad-2: {{ s.gradient_color_2 | default: '#EDE8DF' }};
    --vfc-grad-dir: {{ s.gradient_direction | default: 'to right' }};
    --vfc-custom-max: {{ s.custom_max_width | default: 1200 }}px;
    --vfc-pad-d: {{ s.container_padding_desktop | default: 24 }}px;
    --vfc-pad-t: {{ s.container_padding_tablet | default: 20 }}px;
    --vfc-pad-m: {{ s.container_padding_mobile | default: 16 }}px;
    --vfc-sec-pt-d: {{ s.section_padding_top_desktop | default: 40 }}px;
    --vfc-sec-pb-d: {{ s.section_padding_bottom_desktop | default: 48 }}px;
    --vfc-sec-pt-t: {{ s.section_padding_top_tablet | default: 32 }}px;
    --vfc-sec-pb-t: {{ s.section_padding_bottom_tablet | default: 40 }}px;
    --vfc-sec-pt-m: {{ s.section_padding_top_mobile | default: 24 }}px;
    --vfc-sec-pb-m: {{ s.section_padding_bottom_mobile | default: 32 }}px;
    --vfc-cols-d: {{ s.columns_desktop | default: 4 }};
    --vfc-cols-t: {{ s.columns_tablet | default: 2 }};
    --vfc-cols-m: {{ s.columns_mobile | default: 1 }};
    --vfc-col-gap-d: {{ s.column_gap_desktop | default: 20 }}px;
    --vfc-col-gap-t: {{ s.column_gap_tablet | default: 16 }}px;
    --vfc-col-gap-m: {{ s.column_gap_mobile | default: 12 }}px;
    --vfc-row-gap-d: {{ s.row_gap_desktop | default: 28 }}px;
    --vfc-row-gap-t: {{ s.row_gap_tablet | default: 24 }}px;
    --vfc-row-gap-m: {{ s.row_gap_mobile | default: 20 }}px;
    --vfc-card-bg: {{ s.card_background_color | default: '#F9F7F2' }};
    --vfc-card-radius: {{ s.card_border_radius | default: 0 }}px;
    --vfc-card-border-w: {{ s.card_border_width | default: 0 }}px;
    --vfc-card-border-color: {{ s.card_border_color | default: 'transparent' }};
    --vfc-img-aspect: {{ aspect_css }};
    --vfc-img-fit: {{ s.image_fit | default: 'cover' }};
    --vfc-img-transition: {{ s.image_swap_speed | default: 300 }}ms;
    --vfc-badge-bg: {{ s.badge_background_color | default: '#8B1A1A' }};
    --vfc-badge-text: {{ s.badge_text_color | default: '#ffffff' }};
    --vfc-badge-radius: {{ s.badge_border_radius | default: 2 }}px;
    --vfc-badge-size: {{ s.badge_font_size | default: 11 }}px;
    --vfc-badge-weight: {{ s.badge_font_weight | default: 700 }};
    --vfc-title-size-d: {{ s.title_font_size_desktop | default: 13 }}px;
    --vfc-title-size-t: {{ s.title_font_size_tablet | default: 12 }}px;
    --vfc-title-size-m: {{ s.title_font_size_mobile | default: 12 }}px;
    --vfc-title-weight: {{ s.title_font_weight | default: 700 }};
    --vfc-title-color: {{ s.title_color | default: '#000000' }};
    --vfc-price-size-d: {{ s.price_font_size_desktop | default: 15 }}px;
    --vfc-price-size-t: {{ s.price_font_size_tablet | default: 14 }}px;
    --vfc-price-size-m: {{ s.price_font_size_mobile | default: 14 }}px;
    --vfc-price-weight: {{ s.price_font_weight | default: 700 }};
    --vfc-price-color: {{ s.price_color | default: '#8B1A1A' }};
    --vfc-compare-color: {{ s.compare_color | default: '#888888' }};
    --vfc-swatch-size: {{ s.swatch_size | default: 18 }}px;
    --vfc-swatch-gap: {{ s.swatch_spacing | default: 6 }}px;
    --vfc-swatch-border: {{ s.swatch_border_color | default: '#cccccc' }};
    --vfc-swatch-selected: {{ s.swatch_selected_border_color | default: '#000000' }};
    --vfc-size-h: {{ s.size_button_height | default: 28 }}px;
    --vfc-size-min-w: {{ s.size_button_min_width | default: 32 }}px;
    --vfc-size-gap: {{ s.size_spacing | default: 4 }}px;
    --vfc-size-border: {{ s.size_border_color | default: '#000000' }};
    --vfc-size-selected-bg: {{ s.size_selected_background | default: '#000000' }};
    --vfc-size-selected-text: {{ s.size_selected_text_color | default: '#ffffff' }};
    --vfc-size-disabled-opacity: {{ s.size_disabled_opacity | default: 40 | divided_by: 100.0 }};
    --vfc-atc-bg: {{ s.atc_background_color | default: '#000000' }};
    --vfc-atc-text: {{ s.atc_text_color | default: '#ffffff' }};
    --vfc-atc-hover-bg: {{ s.atc_hover_background_color | default: '#1a1a1a' }};
    --vfc-atc-success-bg: {{ s.atc_success_background_color | default: '#2d6a4f' }};
    --vfc-atc-success-text: {{ s.atc_success_text_color | default: '#ffffff' }};
    --vfc-atc-radius: {{ s.atc_border_radius | default: 0 }}px;
    --vfc-buynow-bg: {{ s.buynow_background_color | default: 'transparent' }};
    --vfc-buynow-text: {{ s.buynow_text_color | default: '#000000' }};
    --vfc-buynow-border: {{ s.buynow_border_color | default: '#000000' }};
    --vfc-buynow-hover-bg: {{ s.buynow_hover_background_color | default: '#000000' }};
    --vfc-buynow-hover-text: {{ s.buynow_hover_text_color | default: '#ffffff' }};
    --vfc-buynow-radius: {{ s.buynow_border_radius | default: 0 }}px;
    --vfc-btn-gap: {{ s.button_gap | default: 8 }}px;
    --vfc-viewcart-bg: {{ s.viewcart_background_color | default: '#ffffff' }};
    --vfc-viewcart-text: {{ s.viewcart_text_color | default: '#000000' }};
    --vfc-viewcart-border: {{ s.viewcart_border_color | default: '#000000' }};
    --vfc-viewcart-hover-bg: {{ s.viewcart_hover_background_color | default: '#000000' }};
    --vfc-viewcart-hover-text: {{ s.viewcart_hover_text_color | default: '#ffffff' }};
    --vfc-msg-bg: {{ s.cart_msg_background_color | default: '#2d6a4f' }};
    --vfc-msg-text: {{ s.cart_msg_text_color | default: '#ffffff' }};
    --vfc-heading-color: {{ s.heading_color | default: '#8B1A1A' }};
    --vfc-subheading-color: {{ s.subheading_color | default: '#000000' }};
    --vfc-heading-size-d: {{ s.heading_font_size_desktop | default: 18 }}px;
    --vfc-heading-size-t: {{ s.heading_font_size_tablet | default: 16 }}px;
    --vfc-heading-size-m: {{ s.heading_font_size_mobile | default: 14 }}px;
    --vfc-sub-size-d: {{ s.subheading_font_size_desktop | default: 14 }}px;
    --vfc-sub-size-t: {{ s.subheading_font_size_tablet | default: 13 }}px;
    --vfc-sub-size-m: {{ s.subheading_font_size_mobile | default: 12 }}px;
    --vfc-offer-gap: {{ s.offer_row_gap | default: 4 }}px;
    --vfc-offer-label-gap: {{ s.offer_label_compare_gap | default: 8 }}px;
  "
>
  <div
    class="viaplush-featured-collection__container{% if container_type == 'theme' %} page-width{% endif %}"
    id="product-list-cm"
  >
    {%- if s.show_header -%}
      <header
        class="viaplush-featured-collection__header viaplush-featured-collection__header--{{ s.heading_alignment | default: 'center' }}"
        style="text-align: {{ s.heading_alignment | default: 'center' }};"
      >
        {%- if s.show_divider_above -%}
          <div class="viaplush-featured-collection__header-divider" aria-hidden="true"></div>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="viaplush-featured-collection__heading">
            {%- if s.show_warning_icon -%}
              <span class="viaplush-featured-collection__warning-icon" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                </svg>
              </span>
            {%- endif -%}
            <span>{{ s.heading }}</span>
          </h2>
        {%- endif -%}
        {%- if s.subheading != blank -%}
          <p class="viaplush-featured-collection__subheading">{{ s.subheading }}</p>
        {%- endif -%}
        {%- if s.show_divider_below -%}
          <div class="viaplush-featured-collection__header-divider" aria-hidden="true"></div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if collection != blank and collection.products_count > 0 -%}
      <div class="viaplush-featured-collection__grid" role="list">
        {%- for product in collection.products limit: product_limit -%}
          {%- liquid
            assign color_index = null
            assign size_index = null
            for option in product.options_with_values
              if option.name == color_option_name
                assign color_index = forloop.index0
              endif
              if option.name == size_option_name
                assign size_index = forloop.index0
              endif
            endfor

            assign first_color = blank
            assign first_variant = null
            for variant in product.variants
              if variant.available
                assign first_variant = variant
                if color_index != null
                  case color_index
                    when 0
                      assign first_color = variant.option1
                    when 1
                      assign first_color = variant.option2
                    when 2
                      assign first_color = variant.option3
                  endcase
                endif
                break
              endif
            endfor
            if first_variant == null
              assign first_variant = product.selected_or_first_available_variant
              if color_index != null
                case color_index
                  when 0
                    assign first_color = first_variant.option1
                  when 1
                    assign first_color = first_variant.option2
                  when 2
                    assign first_color = first_variant.option3
                endcase
              endif
            endif

            assign display_variant = first_variant
            assign front_image = display_variant.featured_image | default: product.featured_image
            assign back_image = null
            if product.images.size > 1
              for image in product.images
                if image.id != front_image.id
                  assign back_image = image
                  break
                endif
              endfor
            endif

            assign on_sale = false
            if display_variant.compare_at_price > display_variant.price
              assign on_sale = true
            endif
            assign product_sold_out = true
            if product.available
              assign product_sold_out = false
            endif

            assign badge_text = blank
            case s.badge_source
              when 'automatic'
                if on_sale
                  assign badge_text = 'SALE'
                endif
              when 'manual'
                assign badge_text = s.manual_badge_text
              when 'metafield'
                assign badge_text = product.metafields.custom.badge | default: product.metafields.theme.badge
              when 'tag'
                if product.tags contains s.badge_tag
                  assign badge_text = s.badge_tag_text | default: s.badge_tag
                endif
            endcase
            if product_sold_out
              assign badge_text = 'SOLD OUT'
            endif
          -%}

          <article
            class="viaplush-featured-collection__card{% if product_sold_out %} viaplush-featured-collection__card--sold-out{% endif %}"
            role="listitem"
            data-product-card
            data-product-id="{{ product.id }}"
          >
            <div class="viaplush-featured-collection__card-inner">
              <div class="viaplush-featured-collection__media-wrap">
                {%- if badge_text != blank -%}
                  <span class="viaplush-featured-collection__badge viaplush-featured-collection__badge--{{ s.badge_position | default: 'top-left' }}">
                    {{- badge_text -}}
                  </span>
                {%- endif -%}
                <a
                  href="{{ product.url }}"
                  class="viaplush-featured-collection__media{% if s.enable_hover_swap %} viaplush-featured-collection__media--swap{% endif %}"
                  data-media-link
                  {% unless s.link_title_to_product %}
                    tabindex="-1" aria-hidden="true"
                  {% endunless %}
                  aria-label="{{ product.title | escape }}"
                >
                  <span class="viaplush-featured-collection__media-inner">
                    {%- if front_image -%}
                      <img
                        class="viaplush-featured-collection__img viaplush-featured-collection__img--front"
                        src="{{ front_image | image_url: width: 600 }}"
                        srcset="{{ front_image | image_url: width: 300 }} 300w, {{ front_image | image_url: width: 450 }} 450w, {{ front_image | image_url: width: 600 }} 600w"
                        sizes="(min-width: 990px) calc((100vw - 80px) / {{ s.columns_desktop | default: 4 }}), (min-width: 750px) calc((100vw - 48px) / {{ s.columns_tablet | default: 2 }}), calc((100vw - 32px) / {{ s.columns_mobile | default: 1 }})"
                        alt="{{ front_image.alt | default: product.title | escape }}"
                        loading="{% if forloop.index > 4 %}lazy{% else %}eager{% endif %}"
                        width="{{ front_image.width }}"
                        height="{{ front_image.height }}"
                        data-front-image
                      >
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'viaplush-featured-collection__placeholder' }}
                    {%- endif -%}
                    {%- if back_image and s.enable_hover_swap -%}
                      <img
                        class="viaplush-featured-collection__img viaplush-featured-collection__img--back"
                        src="{{ back_image | image_url: width: 600 }}"
                        alt="{{ back_image.alt | default: product.title | escape }}"
                        loading="lazy"
                        width="{{ back_image.width }}"
                        height="{{ back_image.height }}"
                        data-back-image
                        hidden
                      >
                    {%- endif -%}
                  </span>
                </a>
              </div>

              <div class="viaplush-featured-collection__body">
                <div class="viaplush-featured-collection__title-row">
                  <div class="viaplush-featured-collection__title-col">
                    {%- if s.link_title_to_product -%}
                      <span
                        class="viaplush-featured-collection__title{% if s.title_truncate %} viaplush-featured-collection__title--clamp{% endif %}"
                        style="--vfc-title-clamp: {{ s.title_max_lines | default: 2 }};"
                      >
                        <a href="{{ product.url }}">{{ product.title }}</a>
                      </span>
                    {%- else -%}
                      <span
                        class="viaplush-featured-collection__title{% if s.title_truncate %} viaplush-featured-collection__title--clamp{% endif %}"
                        style="--vfc-title-clamp: {{ s.title_max_lines | default: 2 }};"
                      >
                        {{ product.title }}
                      </span>
                    {%- endif -%}

                    <div class="viaplush-featured-collection__offers" data-offer-prices>
                      {%- if s.deal_single_text != blank -%}
                        <div class="viaplush-featured-collection__offer-row">
                          <span class="viaplush-featured-collection__offer-label">{{ s.deal_single_text }}</span>
                          {%- if s.deal_single_compare != blank -%}
                            <span class="viaplush-featured-collection__offer-compare"><s>{{ s.deal_single_compare }}</s></span>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                      <div class="viaplush-featured-collection__offer-row">
                        <span class="viaplush-featured-collection__offer-label">
                          {{- s.deal_1_text | default: '2 for $75' -}}
                        </span>
                        <span class="viaplush-featured-collection__offer-compare">
                          <s>{{ s.deal_1_compare | default: '$105' }}</s>
                        </span>
                      </div>
                      <div class="viaplush-featured-collection__offer-row">
                        <span class="viaplush-featured-collection__offer-label">
                          {{- s.deal_2_text | default: '3 for $105' -}}
                        </span>
                        <span class="viaplush-featured-collection__offer-compare">
                          <s>{{ s.deal_2_compare | default: '$156.50' }}</s>
                        </span>
                      </div>
                      <div class="viaplush-featured-collection__offer-row">
                        <span class="viaplush-featured-collection__offer-label">
                          {{- s.deal_3_text | default: '5 for $145' -}}
                        </span>
                        <span class="viaplush-featured-collection__offer-compare">
                          <s>{{ s.deal_3_compare | default: '$258' }}</s>
                        </span>
                      </div>
                      {%- assign deal_note = s.deal_note_text | default: 'Free shipping on every bundle' -%}
                      {%- if deal_note != blank -%}
                        <span class="viaplush-featured-collection__offer-note">{{ deal_note }}</span>
                      {%- endif -%}
                    </div>
                  </div>

                  {%- if color_index != null -%}
                    <fieldset class="viaplush-featured-collection__swatches" data-color-fieldset>
                      <legend class="viaplush-featured-collection__visually-hidden">
                        {{ color_option_name }} for {{ product.title }}
                      </legend>
                      {%- for option in product.options_with_values -%}
                        {%- if option.name == color_option_name -%}
                          {%- for value in option.values -%}
                            {%- liquid
                              assign cv = value.name
                              if cv == blank
                                assign cv = value
                              endif
                              assign color_available = false
                              for v in product.variants
                                case color_index
                                  when 0
                                    if v.option1 == cv and v.available
                                      assign color_available = true
                                    endif
                                  when 1
                                    if v.option2 == cv and v.available
                                      assign color_available = true
                                    endif
                                  when 2
                                    if v.option3 == cv and v.available
                                      assign color_available = true
                                    endif
                                endcase
                              endfor
                              assign swatch_color = value.swatch.color
                              assign swatch_image = value.swatch.image
                            -%}
                            {%- if color_available or s.show_disabled_colors -%}
                              <input
                                type="radio"
                                class="viaplush-featured-collection__swatch-input"
                                name="color-{{ product.id }}-{{ sid }}"
                                id="swatch-{{ product.id }}-{{ cv | handle }}-{{ sid }}"
                                value="{{ cv | escape }}"
                                data-color-value="{{ cv | escape }}"
                                {% if cv == first_color %}
                                  checked
                                {% endif %}
                                {% unless color_available %}
                                  disabled
                                {% endunless %}
                              >
                              <label
                                class="viaplush-featured-collection__swatch viaplush-featured-collection__swatch--{{ s.swatch_shape | default: 'circle' }}{% unless color_available %} viaplush-featured-collection__swatch--disabled{% endunless %}"
                                for="swatch-{{ product.id }}-{{ cv | handle }}-{{ sid }}"
                                title="{{ cv | escape }}"
                              >
                                <span
                                  class="viaplush-featured-collection__swatch-color"
                                  {% if swatch_color != blank %}
                                    style="background-color: {{ swatch_color }};"
                                  {% else %}
                                    data-color-name="{{ cv | escape }}"
                                  {% endif %}
                                >
                                  {%- if swatch_image != blank -%}
                                    <img
                                      src="{{ swatch_image | image_url: width: 80 }}"
                                      alt=""
                                      width="40"
                                      height="40"
                                      loading="lazy"
                                      class="viaplush-featured-collection__swatch-img"
                                    >
                                  {%- endif -%}
                                </span>
                              </label>
                            {%- endif -%}
                          {%- endfor -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </fieldset>
                  {%- endif -%}
                </div>

                {%- if size_index != null -%}
                  <fieldset class="viaplush-featured-collection__sizes" data-size-fieldset>
                    <legend class="viaplush-featured-collection__visually-hidden">
                      {{ size_option_name }} for {{ product.title }}
                    </legend>
                    {%- assign size_values = '' -%}
                    {%- for variant in product.variants -%}
                      {%- case size_index -%}
                        {%- when 0 -%}
                          {%- assign sv = variant.option1 -%}
                        {%- when 1 -%}
                          {%- assign sv = variant.option2 -%}
                        {%- when 2 -%}
                          {%- assign sv = variant.option3 -%}
                      {%- endcase -%}
                      {%- assign size_key = '|' | append: sv | append: '|' -%}
                      {%- unless size_values contains size_key -%}
                        {%- assign size_values = size_values | append: '|' | append: sv | append: '|' -%}
                        {%- assign size_available = false -%}
                        {%- if first_color != blank and color_index != null -%}
                          {%- for v in product.variants -%}
                            {%- assign match_color = false -%}
                            {%- case color_index -%}
                              {%- when 0 -%}
                                {%- if v.option1 == first_color -%}{%- assign match_color = true -%}{%- endif -%}
                              {%- when 1 -%}
                                {%- if v.option2 == first_color -%}{%- assign match_color = true -%}{%- endif -%}
                              {%- when 2 -%}
                                {%- if v.option3 == first_color -%}{%- assign match_color = true -%}{%- endif -%}
                            {%- endcase -%}
                            {%- if match_color -%}
                              {%- case size_index -%}
                                {%- when 0 -%}
                                  {%- if v.option1 == sv and v.available -%}
                                    {%- assign size_available = true -%}
                                  {%- endif -%}
                                {%- when 1 -%}
                                  {%- if v.option2 == sv and v.available -%}
                                    {%- assign size_available = true -%}
                                  {%- endif -%}
                                {%- when 2 -%}
                                  {%- if v.option3 == sv and v.available -%}
                                    {%- assign size_available = true -%}
                                  {%- endif -%}
                              {%- endcase -%}
                            {%- endif -%}
                          {%- endfor -%}
                        {%- else -%}
                          {%- if variant.available -%}{%- assign size_available = true -%}{%- endif -%}
                        {%- endif -%}
                        <input
                          type="radio"
                          class="viaplush-featured-collection__size-input"
                          name="size-{{ product.id }}-{{ sid }}"
                          id="size-{{ product.id }}-{{ sv | handle }}-{{ sid }}"
                          value="{{ sv | escape }}"
                          data-size-value="{{ sv | escape }}"
                          {% unless size_available %}
                            disabled
                          {% endunless %}
                        >
                        <label
                          class="viaplush-featured-collection__size{% unless size_available %} viaplush-featured-collection__size--disabled{% endunless %}"
                          for="size-{{ product.id }}-{{ sv | handle }}-{{ sid }}"
                        >
                          {{- sv -}}
                        </label>
                      {%- endunless -%}
                    {%- endfor -%}
                  </fieldset>
                  <p
                    class="viaplush-featured-collection__size-error"
                    data-size-error
                    role="alert"
                    aria-live="polite"
                    hidden
                  >
                    {{ s.size_error_message | default: 'Please select a size' }}
                  </p>
                {%- endif -%}

                <div class="viaplush-featured-collection__actions">
                  <button
                    type="button"
                    class="viaplush-featured-collection__atc{% if s.atc_full_width %} viaplush-featured-collection__btn--full{% endif %}"
                    data-add-to-cart
                    {% unless product.available %}
                      disabled
                    {% endunless %}
                  >
                    <span class="viaplush-featured-collection__btn-spinner" aria-hidden="true" hidden></span>
                    <span class="viaplush-featured-collection__btn-label" data-atc-text>
                      {%- if product.available -%}
                        {{- s.atc_button_text | default: 'ADD TO CART' -}}
                      {%- else -%}
                        {{- s.sold_out_text | default: 'SOLD OUT' -}}
                      {%- endif -%}
                    </span>
                  </button>
                  <a
                    href="{{ routes.cart_url }}"
                    class="viaplush-featured-collection__viewcart"
                    data-view-cart
                  >
                    <span class="viaplush-featured-collection__btn-label">
                      {{- s.viewcart_button_text | default: 'VIEW CART' -}}
                    </span>
                  </a>
                  <button
                    type="button"
                    class="viaplush-featured-collection__buynow{% if s.buynow_full_width %} viaplush-featured-collection__btn--full{% endif %}"
                    data-checkout
                  >
                    <span class="viaplush-featured-collection__btn-spinner" aria-hidden="true" hidden></span>
                    <span class="viaplush-featured-collection__btn-label" data-checkout-text>
                      {{- s.checkout_button_text | default: 'CHECKOUT' -}}
                    </span>
                  </button>
                </div>

                <div
                  class="viaplush-featured-collection__cart-msg"
                  data-cart-msg
                  role="status"
                  aria-live="polite"
                  hidden
                ></div>
              </div>
            </div>

            <script type="application/json" data-product-data>
              {
                "id": {{ product.id | json }},
                "handle": {{ product.handle | json }},
                "title": {{ product.title | json }},
                "url": {{ product.url | json }},
                "available": {{ product.available | json }},
                "colorIndex": {{ color_index | default: 'null' }},
                "sizeIndex": {{ size_index | default: 'null' }},
                "variants": [
                  {%- for variant in product.variants -%}
                    {
                      "id": {{ variant.id | json }},
                      "available": {{ variant.available | json }},
                      "price": {{ variant.price | json }},
                      "compare_at_price": {{ variant.compare_at_price | json }},
                      "option1": {{ variant.option1 | json }},
                      "option2": {{ variant.option2 | json }},
                      "option3": {{ variant.option3 | json }},
                      "featured_image": {% if variant.featured_image %}{ "id": {{ variant.featured_image.id | json }}, "src": {{ variant.featured_image | image_url: width: 800 | json }}, "alt": {{ variant.featured_image.alt | default: product.title | json }} }{% else %}null{% endif %}
                    }{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                ],
                "images": [
                  {%- for image in product.images -%}
                    {
                      "id": {{ image.id | json }},
                      "src": {{ image | image_url: width: 800 | json }},
                      "alt": {{ image.alt | default: product.title | json }},
                      "variant_ids": {{ image.variants | map: 'id' | json }}
                    }{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                ]
              }
            </script>
          </article>
        {%- endfor -%}
      </div>

      {%- if s.sticky_bar_mode != 'none' -%}
        <div
          class="viaplush-featured-collection__sticky viaplush-featured-collection__sticky--{{ s.sticky_bar_mode | default: 'mobile' }}"
          data-sticky-bar
          aria-hidden="true"
        >
          <div
            class="viaplush-featured-collection__sticky-msg"
            data-sticky-msg
            role="status"
            aria-live="polite"
            hidden
          ></div>
          <div class="viaplush-featured-collection__sticky-actions">
            <a href="{{ routes.cart_url }}" class="viaplush-featured-collection__viewcart" data-view-cart tabindex="-1">
              <span class="viaplush-featured-collection__btn-label">
                {{- s.viewcart_button_text | default: 'VIEW CART' -}}
                <span data-sticky-count>
                  {%- if cart.item_count > 0 %} ({{ cart.item_count }}){% endif -%}
                </span>
              </span>
            </a>
            <button type="button" class="viaplush-featured-collection__buynow" data-checkout tabindex="-1">
              <span class="viaplush-featured-collection__btn-spinner" aria-hidden="true" hidden></span>
              <span class="viaplush-featured-collection__btn-label">
                {{- s.checkout_button_text | default: 'CHECKOUT' -}}
              </span>
            </button>
          </div>
        </div>
      {%- endif -%}

      {%- if s.show_view_all and view_all_url != blank -%}
        <div class="viaplush-featured-collection__view-all-wrap">
          <a href="{{ view_all_url }}" class="viaplush-featured-collection__view-all">
            {{- s.view_all_label | default: 'View All' -}}
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="viaplush-featured-collection__empty">
        <p>{{ s.empty_message | default: 'Select a collection to display products.' }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
