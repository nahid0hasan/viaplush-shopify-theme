<script>
  (function () {
    var root = document.getElementById('viaplush-trust-row-{{ sid }}');
    if (!root || root.dataset.mobileLayout !== 'slideshow') return;

    var track = root.querySelector('[data-trust-slideshow]');
    var dotsWrap = root.querySelector('[data-trust-dots]');
    var prevBtn = root.querySelector('[data-trust-prev]');
    var nextBtn = root.querySelector('[data-trust-next]');
    if (!track) return;

    var slides = track.querySelectorAll('.viaplush-trust-row__item');
    if (!slides.length) return;

    var index = 0;
    var autoplayTimer = null;
    var speed = parseInt(root.dataset.autoplaySpeed, 10) * 1000 || 5000;

    function isMobile() {
      return window.matchMedia('(max-width: 749px)').matches;
    }

    function goTo(i) {
      index = (i + slides.length) % slides.length;
      var slide = slides[index];
      if (slide) {
        track.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
      }
      if (dotsWrap) {
        dotsWrap.querySelectorAll('.viaplush-trust-row__dot').forEach(function (dot, di) {
          dot.classList.toggle('is-active', di === index);
          dot.setAttribute('aria-selected', di === index ? 'true' : 'false');
        });
      }
    }

    function buildDots() {
      if (!dotsWrap || dotsWrap.childElementCount) return;
      slides.forEach(function (_, i) {
        var dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'viaplush-trust-row__dot' + (i === 0 ? ' is-active' : '');
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', 'Go to trust badge ' + (i + 1));
        dot.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
        dot.addEventListener('click', function () {
          goTo(i);
          resetAutoplay();
        });
        dotsWrap.appendChild(dot);
      });
    }

    function startAutoplay() {
      stopAutoplay();
      if (root.dataset.autoplay !== 'true' || !isMobile()) return;
      autoplayTimer = setInterval(function () {
        goTo(index + 1);
      }, speed);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    function resetAutoplay() {
      stopAutoplay();
      startAutoplay();
    }

    buildDots();

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        goTo(index - 1);
        resetAutoplay();
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        goTo(index + 1);
        resetAutoplay();
      });
    }

    track.addEventListener(
      'scroll',
      function () {
        if (!isMobile()) return;
        var scrollLeft = track.scrollLeft;
        var closest = 0;
        var minDist = Infinity;
        slides.forEach(function (slide, i) {
          var dist = Math.abs(slide.offsetLeft - scrollLeft);
          if (dist < minDist) {
            minDist = dist;
            closest = i;
          }
        });
        if (closest !== index) {
          index = closest;
          if (dotsWrap) {
            dotsWrap.querySelectorAll('.viaplush-trust-row__dot').forEach(function (dot, di) {
              dot.classList.toggle('is-active', di === index);
              dot.setAttribute('aria-selected', di === index ? 'true' : 'false');
            });
          }
        }
      },
      { passive: true }
    );

    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);
    root.addEventListener('focusin', stopAutoplay);
    root.addEventListener('focusout', startAutoplay);
    window.addEventListener('resize', startAutoplay);
    startAutoplay();
  })();
</script>
