    if (configEl) {
      try { drawerConfig = JSON.parse(configEl.textContent); } catch (e) { drawerConfig = {}; }
    }

    var panelEl = drawerEl.querySelector('[data-viaplush-cart-panel]');
    var itemsEl = drawerEl.querySelector('[data-viaplush-cart-items]');
    var emptyEl = drawerEl.querySelector('[data-viaplush-cart-empty]');
    var footerEl = drawerEl.querySelector('[data-viaplush-cart-footer]');
    var loadingEl = drawerEl.querySelector('[data-viaplush-cart-loading]');
    var subtotalEl = drawerEl.querySelector('[data-viaplush-cart-subtotal]');
    var checkoutEl = drawerEl.querySelector('[data-viaplush-cart-checkout]');
    var overlayEl = drawerEl.querySelector('.viaplush-cart-drawer__overlay');
    var closeEls = drawerEl.querySelectorAll('[data-viaplush-cart-close]');
    var moneyFormat = drawerConfig.moneyFormat || (window.Shopify && Shopify.money_format) || '';
    var removeLabel = drawerConfig.removeLabel || 'Remove';
    var isOpen = false;
    var isUpdating = false;
    var lastFocus = null;
    var currentCart = null;

    function cartAriaLabel(count) {
      if (count === 1) return 'Open cart, 1 item';
      if (count > 1) return 'Open cart, ' + count + ' items';
      return 'Open cart';
    }

    function formatMoney(cents) {
      if (typeof cents !== 'number') return '';
      if (window.Shopify && typeof Shopify.formatMoney === 'function') {
        return Shopify.formatMoney(cents, moneyFormat);
      }
      return '$' + (cents / 100).toFixed(2);
    }

    function updateCountDisplay(count) {
      if (!countEl || !cartTrigger) return;
      var safeCount = typeof count === 'number' && count >= 0 ? count : 0;
      countEl.textContent = String(safeCount);
      countEl.classList.toggle('viaplush-minimal-header__cart-count--hidden', hideZero && safeCount === 0);
      cartTrigger.setAttribute('aria-label', cartAriaLabel(safeCount));
    }

    function suppressThemeCartDrawer() {
      var selectors = [
        'cart-drawer',
        'cart-drawer-component',
        '#CartDrawer',
        '.drawer--cart',
        '#cart-drawer'
      ];
      selectors.forEach(function (selector) {
        document.querySelectorAll(selector).forEach(function (el) {
          if (el.closest('[data-viaplush-cart-drawer]')) return;
          el.setAttribute('aria-hidden', 'true');
          el.removeAttribute('open');
          if (typeof el.close === 'function') {
            try { el.close(); } catch (e) {}
          }
          el.classList.remove('active', 'is-open', 'animate', 'visible');
        });
      });
      document.documentElement.classList.remove('overflow-hidden', 'cart-open', 'js-drawer-open');
      document.body.classList.remove('overflow-hidden', 'cart-open', 'js-drawer-open');
    }

    function setLoading(loading) {
      if (!loadingEl) return;
      loadingEl.hidden = !loading;
      loadingEl.setAttribute('aria-hidden', loading ? 'false' : 'true');
    }

    function clearLoading() {
      setLoading(false);
      isUpdating = false;
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderCart(cart) {
      currentCart = cart;
      if (!itemsEl || !emptyEl || !footerEl) return;

      clearLoading();

      var items = (cart && cart.items) ? cart.items : [];
      updateCountDisplay(cart ? cart.item_count : 0);

      if (!items.length) {
        itemsEl.innerHTML = '';
        itemsEl.hidden = true;
        emptyEl.hidden = false;
        footerEl.hidden = true;
        return;
      }

      emptyEl.hidden = true;
      itemsEl.hidden = false;
      footerEl.hidden = false;

      itemsEl.innerHTML = items.map(function (item, index) {
        var variantTitle = item.variant_title && item.variant_title !== 'Default Title'
          ? '<p class="viaplush-cart-drawer__item-variant">' + escapeHtml(item.variant_title) + '</p>'
          : '';
        var imageSrc = item.image ? item.image : '';
        var imageAlt = escapeHtml(item.product_title || item.title || '');

        return (
          '<li class="viaplush-cart-drawer__item" data-line-key="' + escapeHtml(item.key) + '" style="animation-delay:' + (index * 40) + 'ms">' +
            (imageSrc
              ? '<img class="viaplush-cart-drawer__item-image" src="' + escapeHtml(imageSrc) + '" alt="' + imageAlt + '" width="72" height="88" loading="lazy">'
              : '<span class="viaplush-cart-drawer__item-image" aria-hidden="true"></span>') +
            '<div class="viaplush-cart-drawer__item-details">' +
              '<p class="viaplush-cart-drawer__item-title">' + escapeHtml(item.product_title || item.title) + '</p>' +
              variantTitle +
              '<div class="viaplush-cart-drawer__item-meta">' +
                '<span class="viaplush-cart-drawer__item-price">' + escapeHtml(formatMoney(item.final_line_price)) + '</span>' +
                '<button type="button" class="viaplush-cart-drawer__item-remove" data-viaplush-cart-remove data-line-key="' + escapeHtml(item.key) + '">' + escapeHtml(removeLabel) + '</button>' +
              '</div>' +
            '</div>' +
          '</li>'
        );
      }).join('');

      if (subtotalEl) subtotalEl.textContent = formatMoney(cart.total_price || 0);
    }

    function fetchCart() {
      return fetch(cartUrl, { credentials: 'same-origin' })
        .then(function (res) { return res.json(); })
        .then(function (cart) {
          renderCart(cart);
          return cart;
        });
    }

    function pulseCartCount() {
      if (!countEl) return;
      countEl.classList.remove('viaplush-minimal-header__cart-count--hidden');
      countEl.classList.remove('viaplush-minimal-header__cart-count--pulse');
      void countEl.offsetWidth;
      countEl.classList.add('viaplush-minimal-header__cart-count--pulse');
    }

    function removeLineItem(lineKey, button) {
      if (!lineKey || isUpdating) return Promise.resolve(null);

      var itemEl = button ? button.closest('.viaplush-cart-drawer__item') : null;
      isUpdating = true;
      if (button) button.disabled = true;
      if (itemEl) itemEl.classList.add('is-removing');

      var safetyTimer = window.setTimeout(clearLoading, 8000);

      return fetch(cartChangeUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ id: lineKey, quantity: 0 })
      })
        .then(function (res) {
          if (!res.ok) return res.json().then(function (e) { throw e; });
          return res.json();
        })
        .then(function (cart) {
          renderCart(cart);
          suppressThemeCartDrawer();
          return cart;
        })
        .catch(function () {
          if (button) button.disabled = false;
          if (itemEl) itemEl.classList.remove('is-removing');
          clearLoading();
          return fetchCart();
        })
        .finally(function () {
          window.clearTimeout(safetyTimer);
          clearLoading();
        });
    }

    function openDrawer(cart, options) {
      options = options || {};
      lastFocus = document.activeElement;
      suppressThemeCartDrawer();

      if (cart) {
        renderCart(cart);
      } else {
        setLoading(true);
        fetchCart()
          .catch(function () {})
          .finally(function () {
            clearLoading();
          });
      }

      drawerEl.classList.add('is-open');
      drawerEl.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('viaplush-cart-drawer-open');
      isOpen = true;
      suppressThemeCartDrawer();

      window.requestAnimationFrame(function () {
        suppressThemeCartDrawer();
        if (panelEl) panelEl.focus();
      });

      if (options.autoOpened) {
        drawerEl.setAttribute('data-auto-opened', 'true');
        window.setTimeout(function () {
          drawerEl.removeAttribute('data-auto-opened');
        }, 500);
      }
    }

    function closeDrawer() {
      if (!isOpen) return;
      clearLoading();
      drawerEl.classList.remove('is-open');
      drawerEl.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('viaplush-cart-drawer-open');
      isOpen = false;
      suppressThemeCartDrawer();
      if (lastFocus && typeof lastFocus.focus === 'function') {
        lastFocus.focus();
      }
    }

    function handleViaplushCartUpdated(event) {
      var detail = event && event.detail ? event.detail : {};
      var cart = detail.cart || null;
      if (!cart || typeof cart.item_count !== 'number') return;
      currentCart = cart;
      if (isOpen) renderCart(cart);
      else updateCountDisplay(cart.item_count);
    }

    function handleCartUpdate(event) {
      var detail = event && event.detail ? event.detail : {};
      if (detail.source === 'viaplush-featured-collection' || detail.source === 'viaplush-cart-drawer') return;
      if (isUpdating) return;

      var cart = detail.cart || detail.cartData || null;
      if (cart && typeof cart.item_count === 'number') {
        if (isOpen) renderCart(cart);
        else updateCountDisplay(cart.item_count);
        return;
      }
      if (isOpen) {
        fetchCart().finally(clearLoading);
      } else {
        fetch(cartUrl, { credentials: 'same-origin' })
          .then(function (res) { return res.json(); })
          .then(function (freshCart) { updateCountDisplay(freshCart.item_count || 0); })
          .catch(function () {});
      }
    }

    function onDrawerClick(event) {
      if (event.target === overlayEl || event.target.closest('[data-viaplush-cart-close]')) {
        event.preventDefault();
        closeDrawer();
        return;
      }

      var removeBtn = event.target.closest('[data-viaplush-cart-remove]');
      if (!removeBtn || removeBtn.disabled || isUpdating) return;

      event.preventDefault();
      event.stopPropagation();
      removeLineItem(removeBtn.getAttribute('data-line-key'), removeBtn);
    }

    if (cartTrigger) {
      cartTrigger.addEventListener('click', function () {
        openDrawer(null);
      });
    }

    drawerEl.addEventListener('click', onDrawerClick);

    document.addEventListener('keydown', function (event) {
      if (!isOpen) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeDrawer();
      }
    });

    document.documentElement.addEventListener('viaplush:cart:updated', handleViaplushCartUpdated);
    document.documentElement.addEventListener('cart:update', handleCartUpdate);
    document.documentElement.addEventListener('cart:refresh', handleCartUpdate);
    document.documentElement.addEventListener('cart:change', handleCartUpdate);
    document.addEventListener('shopify:section:load', function () {
      if (isOpen) fetchCart();
      else fetch(cartUrl, { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (c) { updateCountDisplay(c.item_count || 0); });
    });

    if (typeof window.subscribe === 'function' && window.PUB_SUB_EVENTS && window.PUB_SUB_EVENTS.cartUpdate) {
      window.subscribe(window.PUB_SUB_EVENTS.cartUpdate, function (payload) {
        if (payload && (payload.source === 'viaplush-cart-drawer' || payload.source === 'viaplush-featured-collection')) return;
        if (isUpdating) return;
        if (payload && payload.cartData && typeof payload.cartData.item_count === 'number') {
          handleCartUpdate({ detail: { cart: payload.cartData } });
        } else if (isOpen) {
          fetchCart().finally(clearLoading);
        } else {
          fetch(cartUrl, { credentials: 'same-origin' })
            .then(function (res) { return res.json(); })
            .then(function (cart) { updateCountDisplay(cart.item_count || 0); });
        }
      });
    }

    if (panelEl) {
      panelEl.setAttribute('tabindex', '-1');
    }

    window.ViaplushCartDrawer = {
      open: function (cart) { openDrawer(cart); },
      close: closeDrawer,
      refresh: fetchCart,
      updateCount: function (cart) {
        if (!cart || typeof cart.item_count !== 'number') return;
        currentCart = cart;
        if (isOpen) renderCart(cart);
        else updateCountDisplay(cart.item_count);
      },
      pulseCount: pulseCartCount,
      scrollToHeader: function () {
        if (root) root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      },
      isOpen: function () { return isOpen; },
      getCart: function () { return currentCart; }
    };

    if (stickyEnabled) {
      var spacerEl = document.getElementById('viaplush-header-spacer-{{ sid }}');

      function syncStickySpacer() {
        if (!spacerEl || !root) return;
        spacerEl.style.height = root.getBoundingClientRect().height + 'px';
      }

      var onScroll = function () {
        root.classList.toggle('is-scrolled', window.scrollY > scrollThreshold);
      };

      syncStickySpacer();
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', syncStickySpacer);
      window.addEventListener('load', syncStickySpacer);
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(syncStickySpacer);
      }
    }
  })();
</script>

