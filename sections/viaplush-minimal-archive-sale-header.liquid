<script>
  (function () {
    var root = document.getElementById('viaplush-minimal-header-{{ sid }}');
    var drawerEl = document.getElementById('viaplush-cart-drawer-{{ sid }}');
    if (!root || !drawerEl) return;

    var cartTrigger = root.querySelector('[data-viaplush-cart-trigger]');
    var countEl = root.querySelector('[data-viaplush-cart-count]');
    var hideZero = root.getAttribute('data-hide-zero-count') === 'true';
    var shopRoot = (window.Shopify && Shopify.routes && Shopify.routes.root) ? Shopify.routes.root : '/';
    var cartUrl = shopRoot + 'cart.js';
    var cartChangeUrl = shopRoot + 'cart/change.js';
    var stickyEnabled = {{ sticky_header | json }};
    var scrollThreshold = 4;

