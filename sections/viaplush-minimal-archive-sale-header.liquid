{%- comment -%}
  VIAPLUSH – Minimal Archive Sale Header
  Shopify Online Store 2.0 section for Atelier theme.
  Logo + cart icon only — no navigation, search, or account.
  Scoped to #viaplush-minimal-header-{{ section.id }} — no global styles.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign s = section.settings

  assign container_type = s.container_type | default: 'full'
  assign logo_align = s.logo_alignment | default: 'left'
  assign content_valign = s.content_vertical_align | default: 'center'
  assign icon_style = s.cart_icon_style | default: 'cart-filled'
  if icon_style == 'filled'
    assign icon_style = 'cart-filled'
  elsif icon_style == 'outline'
    assign icon_style = 'cart-outline'
  endif
  assign hide_zero_count = s.hide_zero_count | default: true

  assign logo_image = null
  if s.logo_override != blank
    assign logo_image = s.logo_override
  elsif settings.logo != blank
    assign logo_image = settings.logo
  endif

  assign logo_alt = s.logo_alt | default: shop.name
  assign logo_text = s.logo_text_fallback | default: 'Viaplush'
  assign cart_count = cart.item_count

  assign count_hidden = false
  unless hide_zero_count
    assign count_hidden = false
  else
    if cart_count == 0
      assign count_hidden = true
    endif
  endunless

  assign cart_label = 'Open cart'
  if cart_count == 1
    assign cart_label = 'Open cart, 1 item'
  elsif cart_count > 1
    assign cart_label = 'Open cart, ' | append: cart_count | append: ' items'
  endif

  assign drawer_title = s.drawer_title | default: 'Your Bag'
  assign drawer_checkout_text = s.drawer_checkout_text | default: 'CHECKOUT'
  assign drawer_empty_text = s.drawer_empty_text | default: 'Your bag is empty.'
  assign drawer_remove_label = s.drawer_remove_label | default: 'Remove'

  assign bg_transparent = s.background_transparent | default: false
  assign show_border = s.show_bottom_border | default: true

  assign hide_theme_header = s.hide_theme_header
  if hide_theme_header == null
    assign hide_theme_header = true
  endif

  assign hide_theme_footer = s.hide_theme_footer
  if hide_theme_footer == null
    assign hide_theme_footer = true
  endif

  assign sticky_header = s.sticky_header
  if sticky_header == null
    assign sticky_header = true
  endif

  assign container_pad_d = s.container_padding_desktop | default: s.header_padding_horizontal_desktop | default: 40
  assign container_pad_t = s.container_padding_tablet | default: s.header_padding_horizontal_tablet | default: 28
  assign container_pad_m = s.container_padding_mobile | default: s.header_padding_horizontal_mobile | default: 16
-%}

<div
  id="viaplush-minimal-header-wrap-{{ sid }}"
  class="viaplush-minimal-header-wrap viaplush-minimal-header-wrap--container-{{ container_type }}{% if sticky_header %} viaplush-minimal-header-wrap--sticky{% endif %}"
  style="
    --vmh-sec-pt-d: {{ s.section_padding_top_desktop | default: 0 }}px;
    --vmh-sec-pb-d: {{ s.section_padding_bottom_desktop | default: 0 }}px;
    --vmh-sec-pt-t: {{ s.section_padding_top_tablet | default: 0 }}px;
    --vmh-sec-pb-t: {{ s.section_padding_bottom_tablet | default: 0 }}px;
    --vmh-sec-pt-m: {{ s.section_padding_top_mobile | default: 0 }}px;
    --vmh-sec-pb-m: {{ s.section_padding_bottom_mobile | default: 0 }}px;
    --vmh-pad-x-d: {{ container_pad_d }}px;
    --vmh-pad-x-t: {{ container_pad_t }}px;
    --vmh-pad-x-m: {{ container_pad_m }}px;
  "
>

{%- if hide_theme_header or hide_theme_footer -%}
  <script>
    (function () {
      var root = document.documentElement;
      {%- if hide_theme_header -%}
      root.classList.add('viaplush-landing-hide-theme-header');
      {%- endif -%}
      {%- if hide_theme_footer -%}
      root.classList.add('viaplush-landing-hide-theme-footer');
      {%- endif -%}
    })();
  </script>
  <style id="viaplush-landing-chrome-hide-{{ sid }}">
    {%- if hide_theme_header -%}
    html.viaplush-landing-hide-theme-header #shopify-section-header,
    html.viaplush-landing-hide-theme-header .section-header,
    html.viaplush-landing-hide-theme-header .header-wrapper,
    html.viaplush-landing-hide-theme-header #HeaderWrapper,
    html.viaplush-landing-hide-theme-header sticky-header,
    html.viaplush-landing-hide-theme-header header-component,
    html.viaplush-landing-hide-theme-header .shopify-section-header,
    html.viaplush-landing-hide-theme-header .shopify-section-announcement-bar,
    html.viaplush-landing-hide-theme-header [class*="announcement-bar"],
    html.viaplush-landing-hide-theme-header [id*="shopify-section"][id*="announcement"]:not([id*="cart"]) {
      display: none !important;
    }
    html.viaplush-landing-hide-theme-header cart-drawer,
    html.viaplush-landing-hide-theme-header cart-drawer-component,
    html.viaplush-landing-hide-theme-header #CartDrawer,
    html.viaplush-landing-hide-theme-header [id*="cart-drawer"]:not([id*="viaplush"]),
    html.viaplush-landing-hide-theme-header .cart-drawer:not(.viaplush-cart-drawer),
    html.viaplush-landing-hide-theme-header .drawer--cart,
    html.viaplush-landing-hide-theme-header #cart-drawer {
      display: none !important;
      visibility: hidden !important;
      pointer-events: none !important;
      opacity: 0 !important;
    }
    {%- endif -%}
    {%- if hide_theme_footer -%}
    html.viaplush-landing-hide-theme-footer .shopify-section-group-footer-group,
    html.viaplush-landing-hide-theme-footer #shopify-section-footer,
    html.viaplush-landing-hide-theme-footer .footer,
    html.viaplush-landing-hide-theme-footer .site-footer,
    html.viaplush-landing-hide-theme-footer footer.footer {
      display: none !important;
    }
    {%- endif -%}
  </style>
{%- endif -%}

<header
  id="viaplush-minimal-header-{{ sid }}"
  class="viaplush-minimal-header viaplush-minimal-header--container-{{ container_type }}{% if bg_transparent %} viaplush-minimal-header--bg-transparent{% endif %}{% if show_border %} viaplush-minimal-header--bordered{% endif %}{% if sticky_header %} viaplush-minimal-header--sticky{% endif %}{% if s.sticky_shadow_on_scroll %} viaplush-minimal-header--sticky-shadow{% endif %}"
  role="banner"
  data-viaplush-minimal-header
  data-hide-zero-count="{{ hide_zero_count }}"
  style="
    --vmh-bg: {{ s.background_color | default: '#F9F7F2' }};
    --vmh-bg-scroll: {{ s.sticky_scroll_background | default: '#F9F7F2' }};
    --vmh-border-color: {{ s.border_color | default: '#E8E4DE' }};
    --vmh-border-width: {{ s.border_thickness | default: 1 }}px;
    --vmh-custom-max: {{ s.custom_max_width | default: 1200 }}px;
    --vmh-pad-y-d: {{ s.header_padding_vertical_desktop | default: 22 }}px;
    --vmh-pad-y-t: {{ s.header_padding_vertical_tablet | default: 20 }}px;
    --vmh-pad-y-m: {{ s.header_padding_vertical_mobile | default: 16 }}px;
    --vmh-logo-max-h-d: {{ s.logo_max_height_desktop | default: 42 }}px;
    --vmh-logo-max-h-t: {{ s.logo_max_height_tablet | default: 38 }}px;
    --vmh-logo-max-h-m: {{ s.logo_max_height_mobile | default: 32 }}px;
    --vmh-logo-align: {% if logo_align == 'center' %}center{% else %}flex-start{% endif %};
    --vmh-content-align: {{ content_valign }};
    --vmh-icon-size-d: {{ s.cart_icon_size_desktop | default: 24 }}px;
    --vmh-icon-size-t: {{ s.cart_icon_size_tablet | default: 22 }}px;
    --vmh-icon-size-m: {{ s.cart_icon_size_mobile | default: 20 }}px;
    --vmh-icon-color: {{ s.cart_icon_color | default: '#000000' }};
    --vmh-bubble-bg: {{ s.count_bubble_bg_color | default: '#000000' }};
    --vmh-bubble-text: {{ s.count_bubble_text_color | default: '#ffffff' }};
    --vmh-bubble-top: {{ s.count_bubble_offset_top | default: -6 }}px;
    --vmh-bubble-right: {{ s.count_bubble_offset_right | default: -8 }}px;
    --vmh-dot-color: {{ s.logo_dot_color | default: '#C41E3A' }};
    --vmh-logo-text-color: {{ s.logo_text_color | default: '#000000' }};
    --vmh-logo-text-size-d: {{ s.logo_text_size_desktop | default: 36 }}px;
    --vmh-logo-text-size-t: {{ s.logo_text_size_tablet | default: 32 }}px;
    --vmh-logo-text-size-m: {{ s.logo_text_size_mobile | default: 28 }}px;
    --vmh-focus-color: {{ s.cart_focus_color | default: '#000000' }};
    {%- if s.tagline_color != blank %}
    --vmh-tagline-color: {{ s.tagline_color }};
    {%- endif %}
    {%- if s.tagline_accent_color != blank %}
    --vmh-tagline-accent: {{ s.tagline_accent_color }};
    {%- endif %}
  "
>
  <div class="viaplush-minimal-header__container{% if container_type == 'theme' %} page-width{% endif %}">
    <div class="viaplush-minimal-header__inner{% if logo_align == 'center' %} viaplush-minimal-header__inner--center{% endif %}">
      <div class="viaplush-minimal-header__logo" aria-hidden="false">
        {%- if logo_image != blank -%}
          {{
            logo_image
            | image_url: width: 600
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              alt: logo_alt,
              class: 'viaplush-minimal-header__logo-image',
              widths: '120, 180, 240, 360, 480, 600'
          }}
        {%- else -%}
          <span class="viaplush-minimal-header__logo-text" aria-label="{{ logo_alt }}">
            <span class="viaplush-minimal-header__logo-word">{{ logo_text }}</span
            ><span class="viaplush-minimal-header__logo-dot" aria-hidden="true">.</span>
          </span>
        {%- endif -%}
        {%- if s.tagline != blank -%}
          <span class="viaplush-minimal-header__tagline">{{ s.tagline | escape }}</span>
        {%- endif -%}
      </div>

      <div class="viaplush-minimal-header__cart-wrap">
        <button
          type="button"
          class="viaplush-minimal-header__cart"
          data-viaplush-cart-trigger
          aria-label="{{ cart_label }}"
          aria-haspopup="dialog"
          aria-controls="viaplush-cart-drawer-{{ sid }}"
        >
          <span class="viaplush-minimal-header__cart-icon" aria-hidden="true">
            {%- case icon_style -%}
              {%- when 'bag-filled' -%}
                <svg
                  class="viaplush-minimal-header__cart-svg viaplush-minimal-header__cart-svg--fa-bag"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 448 512"
                  focusable="false"
                  aria-hidden="true"
                >
                  <path fill="currentColor" d="M160 112c0-35.3 28.7-64 64-64s64 28.7 64 64v48H160V112zm-48 48H48c-26.5 0-48 21.5-48 48V416c0 53 43 96 96 96H352c53 0 96-43 96-96V208c0-26.5-21.5-48-48-48H336 112 48zm0 48H336V416c0 26.5-21.5 48-48 48H160c-26.5 0-48-21.5-48-48V208z"/>
                </svg>
              {%- when 'cart-outline' -%}
                <svg
                  class="viaplush-minimal-header__cart-svg viaplush-minimal-header__cart-svg--fa-cart-outline"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 576 512"
                  focusable="false"
                  aria-hidden="true"
                >
                  <path fill="currentColor" d="M24 48C10.7 48 0 58.7 0 72v0c0 13.3 10.7 24 24 24H69.5c3.9 0 7.2 2.7 7.9 6.5l51.6 271.6c5.7 29.8 32.1 51.4 62.4 51.4H488c13.3 0 24-10.7 24-24s-10.7-24-24-24H191.4L184 192H492.8l-32.9-121.6C454.4 45.1 426.3 0 388.5 0H106.8C87.6 0 70.6 12.5 64.8 30.7L45.3 88H24zm96 368a48 48 0 1 1 0 96 48 48 0 1 1 0-96zm336 0a48 48 0 1 1 0 96 48 48 0 1 1 0-96z"/>
                </svg>
              {%- else -%}
                <svg
                  class="viaplush-minimal-header__cart-svg viaplush-minimal-header__cart-svg--fa-cart-filled"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 576 512"
                  focusable="false"
                  aria-hidden="true"
                >
                  <path fill="currentColor" d="M0 24C0 10.7 10.7 0 24 0H69.5c22 0 41.5 12.8 50.6 32h411c26.3 0 45.5 25 38.6 50.4l-41 152.3c-8.5 31.4-37 53.3-69.5 53.3H170.7l5.4 28.5c2.2 11.3 12.1 19.5 23.6 19.5H488c13.3 0 24 10.7 24 24s-10.7 24-24 24H199.7c-34.6 0-64.3-24.6-70.7-58.5L77.4 54.5c-.7-3.8-4-6.5-7.9-6.5H24C10.7 48 0 37.3 0 24zM128 464a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zm336 0a48 48 0 1 1 96 0 48 48 0 1 1 -96 0z"/>
                </svg>
            {%- endcase -%}
          </span>
          <span
            class="viaplush-minimal-header__cart-count{% if count_hidden %} viaplush-minimal-header__cart-count--hidden{% endif %}"
            data-viaplush-cart-count
            aria-hidden="true"
          >
            {{- cart_count -}}
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

{%- if sticky_header -%}
  <div class="viaplush-minimal-header__sticky-spacer" id="viaplush-header-spacer-{{ sid }}" aria-hidden="true"></div>
{%- endif -%}
</div>

<div
  id="viaplush-cart-drawer-{{ sid }}"
  class="viaplush-cart-drawer"
  data-viaplush-cart-drawer
  aria-hidden="true"
  style="
    --vcd-bg: {{ s.drawer_background_color | default: '#F9F7F2' }};
    --vcd-text: {{ s.drawer_text_color | default: '#000000' }};
    --vcd-muted: {{ s.drawer_muted_color | default: '#666666' }};
    --vcd-border: {{ s.drawer_border_color | default: '#E8E4DE' }};
    --vcd-overlay: {{ s.drawer_overlay_color | default: 'rgba(0, 0, 0, 0.45)' }};
    --vcd-btn-bg: {{ s.drawer_checkout_bg | default: '#000000' }};
    --vcd-btn-text: {{ s.drawer_checkout_text_color | default: '#ffffff' }};
    --vcd-btn-hover: {{ s.drawer_checkout_hover_bg | default: '#1a1a1a' }};
    --vcd-width-d: {{ s.drawer_width_desktop | default: 420 }}px;
    --vcd-width-m: {{ s.drawer_width_mobile | default: 100 }}%;
    --vcd-pad: {{ s.drawer_padding | default: 24 }}px;
  "
>
  <div class="viaplush-cart-drawer__overlay" data-viaplush-cart-close tabindex="-1" aria-hidden="true"></div>
  <aside
    class="viaplush-cart-drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-label="{{ drawer_title }}"
    data-viaplush-cart-panel
  >
    <header class="viaplush-cart-drawer__header">
      <span class="viaplush-cart-drawer__title">{{ drawer_title }}</span>
      <button
        type="button"
        class="viaplush-cart-drawer__close"
        data-viaplush-cart-close
        aria-label="Close cart"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </header>

    <div class="viaplush-cart-drawer__body" data-viaplush-cart-body>
      <div class="viaplush-cart-drawer__loading" data-viaplush-cart-loading hidden>
        <span class="viaplush-cart-drawer__spinner" aria-hidden="true"></span>
      </div>
      <div class="viaplush-cart-drawer__empty" data-viaplush-cart-empty hidden>
        <p>{{ drawer_empty_text }}</p>
      </div>
      <ul class="viaplush-cart-drawer__items" data-viaplush-cart-items role="list"></ul>
    </div>

    <footer class="viaplush-cart-drawer__footer" data-viaplush-cart-footer hidden>
      <div class="viaplush-cart-drawer__subtotal">
        <span class="viaplush-cart-drawer__subtotal-label">Subtotal</span>
        <span class="viaplush-cart-drawer__subtotal-value" data-viaplush-cart-subtotal></span>
      </div>
      <a
        href="{{ routes.root_url }}checkout"
        class="viaplush-cart-drawer__checkout"
        data-viaplush-cart-checkout
      >
        {{ drawer_checkout_text }}
      </a>
    </footer>
  </aside>
</div>

<script type="application/json" data-viaplush-cart-drawer-config>
  {
    "moneyFormat": {{ shop.money_format | json }},
    "removeLabel": {{ drawer_remove_label | json }},
    "emptyText": {{ drawer_empty_text | json }},
    "checkoutUrl": {{ routes.root_url | append: 'checkout' | json }}
  }
</script>

<style>
  @font-face {
    font-family: 'Coastal';
    src: url('{{ 'Coastal.otf' | asset_url }}') format('opentype');
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
  }

  #shopify-section-{{ sid }} {
    overflow: visible !important;
  }

  #viaplush-minimal-header-wrap-{{ sid }} {
    width: 100%;
    box-sizing: border-box;
    padding-top: var(--vmh-sec-pt-d);
    padding-bottom: var(--vmh-sec-pb-d);
  }

  #viaplush-minimal-header-wrap-{{ sid }}.viaplush-minimal-header-wrap--sticky {
    position: relative;
    z-index: 10040;
  }

  #viaplush-minimal-header-wrap-{{ sid }} .viaplush-minimal-header__sticky-spacer {
    display: block;
    width: 100%;
    height: 0;
    pointer-events: none;
  }

  #viaplush-minimal-header-{{ sid }} {
    width: 100%;
    box-sizing: border-box;
    background-color: var(--vmh-bg);
    position: relative;
    z-index: 10040;
  }

  #viaplush-minimal-header-{{ sid }}.viaplush-minimal-header--bg-transparent {
    background-color: transparent;
  }

  #viaplush-minimal-header-{{ sid }}.viaplush-minimal-header--bordered {
    border-bottom: var(--vmh-border-width) solid var(--vmh-border-color);
  }

  #viaplush-minimal-header-{{ sid }}.viaplush-minimal-header--sticky {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 10040;
    transition: background-color 0.25s ease, box-shadow 0.25s ease;
  }

  #viaplush-minimal-header-{{ sid }}.viaplush-minimal-header--sticky.is-scrolled {
    background-color: var(--vmh-bg-scroll);
  }

  #viaplush-minimal-header-{{ sid }}.viaplush-minimal-header--sticky-shadow.is-scrolled {
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06), 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  #viaplush-minimal-header-{{ sid }} .viaplush-minimal-header__container {
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  #viaplush-minimal-header-{{ sid }}.viaplush-minimal-header--container-theme .viaplush-minimal-header__container {
    max-width: var(--page-width, 1200px);
    padding-left: var(--vmh-pad-x-d);
    padding-right: var(--vmh-pad-x-d);
  }

  #viaplush-minimal-header-{{ sid }}.viaplush-minimal-header--container-full .viaplush-minimal-header__container {
    max-width: 100%;
    padding-left: var(--vmh-pad-x-d);
    padding-right: var(--vmh-pad-x-d);
  }

  #viaplush-minimal-header-{{ sid }}.viaplush-minimal-header--container-custom .viaplush-minimal-header__container {
    max-width: var(--vmh-custom-max);
    padding-left: var(--vmh-pad-x-d);
    padding-right: var(--vmh-pad-x-d);
  }

  #viaplush-minimal-header-{{ sid }} .viaplush-minimal-header__inner {
    display: flex;
    align-items: var(--vmh-content-align);
    justify-content: space-between;
    gap: 16px;
    min-height: 0;
    padding-top: var(--vmh-pad-y-d);
    padding-bottom: var(--vmh-pad-y-d);
    width: 100%;
    box-sizing: border-box;
  }

  #viaplush-minimal-header-{{ sid }} .viaplush-minimal-header__logo {
    display: flex;
    align-items: center;
    justify-content: var(--vmh-logo-align);
    flex: 1 1 auto;
    min-width: 0;
    max-width: calc(100% - 56px);
  }

  #viaplush-minimal-header-{{ sid }} .viaplush-minimal-header__logo-image {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: var(--vmh-logo-max-h-d);
    object-fit: contain;
    object-position: left center;
  }

  #viaplush-minimal-header-{{ sid }} .viaplush-minimal-header__logo-text {
    display: inline-flex;
    align-items: baseline;
    max-width: 100%;
    color: var(--vmh-logo-text-color);
    font-family: 'Coastal', serif;
    font-style: normal;
    font-weight: 700;
    font-size: var(--vmh-logo-text-size-d);
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #viaplush-minimal-header-{{ sid }} .viaplush-minimal-header__logo-word {
    display: inline-block;
    font-family: inherit;
    font-weight: inherit;
  }

  #viaplush-minimal-header-{{ sid }} .viaplush-minimal-header__logo-dot {
    color: var(--vmh-dot-color);
    font-style: normal;
    font-weight: 700;
    margin-left: 1px;
  }

  /* Optional tagline under the logo (used by landing pages; blank by default). */
  #viaplush-minimal-header-{{ sid }} .viaplush-minimal-header__logo:has(.viaplush-minimal-header__tagline) {
    flex-direction: column;
    align-items: var(--vmh-logo-align);
    justify-content: center;
    gap: 6px;
  }

  #viaplush-minimal-header-{{ sid }} .viaplush-minimal-header__tagline {
    display: block;
    color: var(--vmh-tagline-color, var(--vmh-logo-text-color));
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
  }

  #viaplush-minimal-header-{{ sid }} .viaplush-minimal-header__tagline::after {
    content: '';
    display: block;
    inline-size: 70%;
    block-size: 3px;
    margin: 8px auto 0;
    border-radius: 50%;
    background: linear-gradient(90deg, transparent, var(--vmh-tagline-accent, transparent) 25%, var(--vmh-tagline-accent, transparent) 75%, transparent);
  }

  /* Centered logo: balance the cart column so the logo sits on the true page center. */
  #viaplush-minimal-header-{{ sid }} .viaplush-minimal-header__inner--center::before {
    content: '';
    flex: 0 0 56px;
  }

  #viaplush-minimal-header-{{ sid }} .viaplush-minimal-header__inner--center .viaplush-minimal-header__logo-image {
    object-position: center;
