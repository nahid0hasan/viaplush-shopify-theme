{% doc %}
  @prompt
    Create a custom image block for a hero section that allows the merchant to upload a logo and adjust its size with width and height controls. Include settings for:
    - Image upload
    - Width control (with options like small, medium, large, or custom pixel width)
    - Height control or maintain aspect ratio option
    - Alignment options (left, center, right)
    The block should be clean and simple, designed specifically for displaying a logo that can be easily resized.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-block-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-logo-container-{{ ai_gen_id }} {
    display: flex;
    width: 100%;
    {% if block.settings.alignment == 'left' %}
      justify-content: flex-start;
    {% elsif block.settings.alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.alignment == 'right' %}
      justify-content: flex-end;
    {% endif %}
  }

  .ai-logo-wrapper-{{ ai_gen_id }} {
    {% if block.settings.width_type == 'custom' %}
      width: {{ block.settings.custom_width }}px;
    {% elsif block.settings.width_type == 'small' %}
      width: 150px;
    {% elsif block.settings.width_type == 'medium' %}
      width: 300px;
    {% elsif block.settings.width_type == 'large' %}
      width: 450px;
    {% endif %}
    max-width: 100%;
  }

  .ai-logo-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    {% if block.settings.maintain_aspect_ratio %}
      object-fit: contain;
    {% else %}
      height: {{ block.settings.custom_height }}px;
      object-fit: cover;
    {% endif %}
  }

  .ai-logo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    {% if block.settings.maintain_aspect_ratio %}
      aspect-ratio: 16 / 9;
    {% else %}
      height: {{ block.settings.custom_height }}px;
    {% endif %}
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-logo-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-logo-wrapper-{{ ai_gen_id }} {
      {% if block.settings.width_type == 'custom' %}
        width: {{ block.settings.custom_width | times: 0.7 }}px;
      {% elsif block.settings.width_type == 'small' %}
        width: 120px;
      {% elsif block.settings.width_type == 'medium' %}
        width: 200px;
      {% elsif block.settings.width_type == 'large' %}
        width: 280px;
      {% endif %}
    }

    {% unless block.settings.maintain_aspect_ratio %}
      .ai-logo-image-{{ ai_gen_id }} {
        height: {{ block.settings.custom_height | times: 0.7 }}px;
      }

      .ai-logo-placeholder-{{ ai_gen_id }} {
        height: {{ block.settings.custom_height | times: 0.7 }}px;
      }
    {% endunless %}
  }
{% endstyle %}

<logo-block-{{ ai_gen_id }} class="ai-logo-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-logo-container-{{ ai_gen_id }}">
    <div class="ai-logo-wrapper-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <img
          src="{{ block.settings.logo | image_url: width: 1200 }}"
          alt="{{ block.settings.logo.alt | escape }}"
          class="ai-logo-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.logo.width }}"
          height="{{ block.settings.logo.height }}"
        >
      {% else %}
        <div class="ai-logo-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-logo-empty-state-{{ ai_gen_id }}">
            Upload your logo
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</logo-block-{{ ai_gen_id }}>

<script>
  (function() {
    class LogoBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('logo-block-{{ ai_gen_id }}', LogoBlock{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Logo image",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "select",
      "id": "width_type",
      "label": "Width",
      "options": [
        {
          "value": "small",
          "label": "Small (150px)"
        },
        {
          "value": "medium",
          "label": "Medium (300px)"
        },
        {
          "value": "large",
          "label": "Large (450px)"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 50,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "type": "checkbox",
      "id": "maintain_aspect_ratio",
      "label": "Maintain aspect ratio",
      "default": true
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom height",
      "min": 50,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Logo image"
    }
  ]
}
{% endschema %}
