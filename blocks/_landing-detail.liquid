{%- doc -%}
  Renders one close-up detail card (square image, title, caption) as a list item inside
  `sections/landing-details.liquid`.

  @example
  {% content_for 'blocks' %}
{%- enddoc -%}

{%- render 'landing-styles' -%}

<li class="lp-detail" {{ block.shopify_attributes }}>
  <div class="lp-detail__media">
    {%- if block.settings.image -%}
      {{
        block.settings.image
        | image_url: width: 700
        | image_tag:
          widths: '280, 420, 560, 700',
          sizes: '(min-width: 990px) 240px, (min-width: 750px) 30vw, 70vw',
          loading: 'lazy',
          alt: block.settings.image.alt
      }}
    {%- elsif block.settings.image_asset != blank -%}
      <img
        src="{{ block.settings.image_asset | asset_url }}"
        alt="{{ block.settings.title | escape }}"
        width="360"
        height="232"
        loading="lazy"
      >
    {%- else -%}
      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'lp-detail__placeholder' }}
    {%- endif -%}
  </div>
  {%- if block.settings.title != blank -%}
    <h3 class="lp-detail__title">{{ block.settings.title | escape }}</h3>
  {%- endif -%}
  {%- if block.settings.caption != blank -%}
    <p class="lp-detail__caption">{{ block.settings.caption | escape }}</p>
  {%- endif -%}
</li>

{% stylesheet %}
  .lp-detail {
    display: grid;
    align-content: start;
    gap: 6px;
    min-inline-size: 0;
    scroll-snap-align: start;
    text-align: center;
  }

  .lp-detail__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    margin-block-end: 6px;
    border: 4px solid #fff;
    border-radius: var(--lp-radius-sm);
    background-color: var(--lp-peach);
    box-shadow: var(--lp-shadow);
  }

  .lp-detail__media img,
  .lp-detail__placeholder {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .lp-detail__title {
    margin: 0;
    color: var(--lp-text);
    font-size: 1rem;
    font-weight: 800;
  }

  .lp-detail__caption {
    margin: 0;
    color: var(--lp-muted);
    font-size: 0.875rem;
    font-style: italic;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:landing.names.landing_detail",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:landing.settings.image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "t:landing.settings.image_asset",
      "info": "t:landing.content.image_asset_info"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:landing.settings.title",
      "default": "Iconic artwork"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:landing.settings.caption",
      "default": "Bold. Cultural. Timeless."
    }
  ],
  "presets": [
    {
      "name": "t:landing.names.landing_detail"
    }
  ]
}
{% endschema %}
