{% comment %}
  LVLS Agency — Scarcity + Urgency Bar
  Shows low-stock warning and a fit note.
  Usage: {% render 'lvls-scarcity', variant: product.selected_or_first_available_variant %}
{% endcomment %}

{%- assign v = variant | default: product.selected_or_first_available_variant -%}
{%- assign qty = v.inventory_quantity -%}
{%- assign policy = v.inventory_policy -%}
{%- assign managed = false -%}
{%- if v.inventory_management == 'shopify' -%}{%- assign managed = true -%}{%- endif -%}

<div
  class="lvls-scarcity"
  id="lvls-scarcity"
  data-section-id="{{ section.id }}"
>
  {%- if managed -%}
    {%- if qty <= 0 and policy == 'deny' -%}
      <div class="lvls-scarcity__msg lvls-scarcity__msg--out">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        Sold out in this size
      </div>
    {%- elsif qty > 0 and qty <= 5 -%}
      <div class="lvls-scarcity__msg lvls-scarcity__msg--low">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        Only {{ qty }} left — selling fast
      </div>
    {%- elsif qty > 5 and qty <= 12 -%}
      <div class="lvls-scarcity__msg lvls-scarcity__msg--low">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        Low stock — {{ qty }} remaining
      </div>
    {%- else -%}
      <div class="lvls-scarcity__msg lvls-scarcity__msg--in">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        In stock — ships in 2–4 business days
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="lvls-scarcity__msg lvls-scarcity__msg--in">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
      In stock — ships in 2–4 business days
    </div>
  {%- endif -%}

  <div class="lvls-scarcity__fit-note">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    Relaxed/oversized fit — consider sizing down
  </div>
</div>

{% stylesheet %}
  .lvls-scarcity {
    margin-bottom: 8px;
  }

  .lvls-scarcity__msg {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 12px;
    border-radius: 4px;
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .lvls-scarcity__msg--low {
    background: #fff8e6;
    color: #8a5a00;
    border: 1px solid #f5d78a;
  }

  .lvls-scarcity__msg--in {
    background: #f0faf0;
    color: #2a6a2a;
    border: 1px solid #a8d8a8;
  }

  .lvls-scarcity__msg--out {
    background: #fff0f0;
    color: #8a0000;
    border: 1px solid #f5a8a8;
  }

  .lvls-scarcity__fit-note {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    color: #666;
    margin-bottom: 4px;
  }
{% endstylesheet %}
