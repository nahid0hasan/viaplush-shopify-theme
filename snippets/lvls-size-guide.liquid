{% comment %}
  LVLS Agency — Size Guide Snippet
  Renders a modal size chart with US measurements.
  Usage: {% render 'lvls-size-guide' %}
{% endcomment %}

<div class="lvls-size-guide">
  <button
    class="lvls-size-guide__trigger"
    type="button"
    aria-controls="lvls-size-modal"
    aria-expanded="false"
    onclick="
      var m = document.getElementById('lvls-size-modal');
      var open = m.getAttribute('aria-hidden') === 'false';
      m.setAttribute('aria-hidden', open ? 'true' : 'false');
      this.setAttribute('aria-expanded', open ? 'false' : 'true');
    "
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 3H3v18l4-4 4 4 4-4 4 4V3z"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="13" x2="13" y2="13"/></svg>
    Size guide
  </button>

  <div
    id="lvls-size-modal"
    class="lvls-size-modal"
    aria-hidden="true"
    role="dialog"
    aria-label="Size guide"
  >
    <div class="lvls-size-modal__overlay" onclick="document.getElementById('lvls-size-modal').setAttribute('aria-hidden','true');"></div>
    <div class="lvls-size-modal__box">
      <button
        class="lvls-size-modal__close"
        type="button"
        aria-label="Close size guide"
        onclick="document.getElementById('lvls-size-modal').setAttribute('aria-hidden','true');"
      >
        &times;
      </button>
      <h3 class="lvls-size-modal__title">Size guide</h3>
      <p class="lvls-size-modal__note">Viaplush fits relaxed &amp; oversized. When in doubt, size down one.</p>
      <div class="lvls-size-modal__table-wrap">
        <table class="lvls-size-modal__table">
          <thead>
            <tr>
              <th>Size</th>
              <th>Chest (in)</th>
              <th>Length (in)</th>
              <th>Shoulder (in)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>XS</td><td>36–38</td><td>27</td><td>17</td></tr>
            <tr><td>S</td><td>38–40</td><td>28</td><td>18</td></tr>
            <tr><td>M</td><td>40–42</td><td>29</td><td>19</td></tr>
            <tr><td>L</td><td>42–44</td><td>30</td><td>20</td></tr>
            <tr><td>XL</td><td>44–46</td><td>31</td><td>21</td></tr>
            <tr><td>2XL</td><td>46–48</td><td>32</td><td>22</td></tr>
            <tr><td>3XL</td><td>48–50</td><td>33</td><td>23</td></tr>
          </tbody>
        </table>
      </div>
      <p class="lvls-size-modal__measure"><strong>How to measure chest:</strong> Wrap a tape measure around the fullest part of your chest, keeping it level under your arms.</p>
    </div>
  </div>
</div>

{% stylesheet %}
  .lvls-size-guide__trigger {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    padding: 0;
    font-size: 12px;
    color: var(--color-primary, #555);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
    font-family: inherit;
    margin-top: 4px;
  }

  .lvls-size-guide__trigger:hover {
    opacity: 0.75;
  }

  .lvls-size-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .lvls-size-modal[aria-hidden="false"] {
    opacity: 1;
    pointer-events: auto;
  }

  .lvls-size-modal__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.55);
  }

  .lvls-size-modal__box {
    position: relative;
    background: #fff;
    color: #1a1a1a;
    border-radius: 8px;
    padding: 28px 24px 24px;
    max-width: 520px;
    width: calc(100% - 32px);
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 8px 40px rgba(0,0,0,0.18);
  }

  .lvls-size-modal__close {
    position: absolute;
    top: 14px;
    right: 16px;
    background: none;
    border: none;
    font-size: 22px;
    cursor: pointer;
    color: #555;
    line-height: 1;
    padding: 4px;
  }

  .lvls-size-modal__close:hover { color: #000; }

  .lvls-size-modal__title {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 6px;
  }

  .lvls-size-modal__note {
    font-size: 13px;
    color: #666;
    margin: 0 0 16px;
    background: #fef9ec;
    border-left: 3px solid #d4a017;
    padding: 8px 12px;
    border-radius: 0 4px 4px 0;
  }

  .lvls-size-modal__table-wrap {
    overflow-x: auto;
    margin-bottom: 16px;
  }

  .lvls-size-modal__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .lvls-size-modal__table th {
    background: #1a1a1a;
    color: #fff;
    padding: 9px 14px;
    text-align: left;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .lvls-size-modal__table td {
    padding: 8px 14px;
    border-bottom: 1px solid #eee;
  }

  .lvls-size-modal__table tbody tr:nth-child(even) td {
    background: #f9f9f9;
  }

  .lvls-size-modal__table td:first-child {
    font-weight: 600;
  }

  .lvls-size-modal__measure {
    font-size: 12px;
    color: #666;
    margin: 0;
    line-height: 1.5;
  }
{% endstylesheet %}
